{
 "title": "POV: You Did 10 Small Things for a Year \u2014 You're $5,300 Richer, Your Friends Are Still Broke",
 "duration": 240.644,
 "scenes": [
  {
   "id": "s0",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 0.3,
   "end": 7.211,
   "line_starts": [
    0.3,
    3.974
   ],
   "subs": [
    {
     "start": 0.3,
     "end": 1.371,
     "text": "It's New Year's Eve."
    },
    {
     "start": 1.371,
     "end": 3.674,
     "text": "Your friends are making big promises again."
    },
    {
     "start": 3.974,
     "end": 5.168,
     "text": "New gym. New diet."
    },
    {
     "start": 5.168,
     "end": 6.761,
     "text": "This is finally my year."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 7.211,
   "end": 12.217,
   "line_starts": [
    7.211,
    8.941
   ],
   "subs": [
    {
     "start": 7.211,
     "end": 8.641,
     "text": "And you? You're just smiling."
    },
    {
     "start": 8.941,
     "end": 9.964,
     "text": "Because one year ago,"
    },
    {
     "start": 9.964,
     "end": 11.767,
     "text": "you made a different kind of promise."
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 12.217,
   "end": 16.917,
   "line_starts": [
    12.217,
    14.768
   ],
   "subs": [
    {
     "start": 12.217,
     "end": 13.475,
     "text": "Not one big change."
    },
    {
     "start": 13.475,
     "end": 14.468,
     "text": "Ten small ones."
    },
    {
     "start": 14.768,
     "end": 16.467,
     "text": "So small they almost felt silly."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 16.917,
   "end": 24.184,
   "line_starts": [
    16.917,
    21.547
   ],
   "subs": [
    {
     "start": 16.917,
     "end": 19.226,
     "text": "Tonight, your savings account says five thousand"
    },
    {
     "start": 19.226,
     "end": 21.247,
     "text": "three hundred dollars more than last year."
    },
    {
     "start": 21.547,
     "end": 23.129,
     "text": "And your life feels calmer than it"
    },
    {
     "start": 23.129,
     "end": 23.734,
     "text": "has in years."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 24.184,
   "end": 29.775,
   "line_starts": [
    24.184,
    26.45
   ],
   "subs": [
    {
     "start": 24.184,
     "end": 26.15,
     "text": "Meanwhile, Jake just checked his card."
    },
    {
     "start": 26.45,
     "end": 28.349,
     "text": "He spent more on holiday gifts than"
    },
    {
     "start": 28.349,
     "end": 29.325,
     "text": "he has in savings."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 29.775,
   "end": 34.476,
   "line_starts": [
    29.775
   ],
   "subs": [
    {
     "start": 29.775,
     "end": 31.574,
     "text": "Here are the ten small things you"
    },
    {
     "start": 31.574,
     "end": 34.026,
     "text": "did. And exactly how much each one was worth."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 34.476,
   "end": 41.328,
   "line_starts": [
    34.476,
    36.946
   ],
   "subs": [
    {
     "start": 34.476,
     "end": 36.646,
     "text": "Thing number one. You paid yourself first."
    },
    {
     "start": 36.946,
     "end": 39.772,
     "text": "Fifty dollars, moved automatically to savings,"
    },
    {
     "start": 39.772,
     "end": 40.878,
     "text": "every single week."
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 41.328,
   "end": 47.378,
   "line_starts": [
    41.328,
    43.985
   ],
   "subs": [
    {
     "start": 41.328,
     "end": 42.556,
     "text": "You never saw that money,"
    },
    {
     "start": 42.556,
     "end": 43.685,
     "text": "so you never missed it."
    },
    {
     "start": 43.985,
     "end": 46.928,
     "text": "By December, that alone was twenty six hundred dollars."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 47.378,
   "end": 54.233,
   "line_starts": [
    47.378,
    52.159
   ],
   "subs": [
    {
     "start": 47.378,
     "end": 49.012,
     "text": "Thing number two. Every Sunday,"
    },
    {
     "start": 49.012,
     "end": 51.016,
     "text": "five minutes. You opened your bank app"
    },
    {
     "start": 51.016,
     "end": 51.859,
     "text": "and just looked."
    },
    {
     "start": 52.159,
     "end": 53.783,
     "text": "No judging. Just looking."
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 54.233,
   "end": 59.112,
   "line_starts": [
    54.233,
    56.842
   ],
   "subs": [
    {
     "start": 54.233,
     "end": 56.542,
     "text": "Most people avoid that app when money is tight."
    },
    {
     "start": 56.842,
     "end": 58.662,
     "text": "Mia hadn't opened hers in two months."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 59.112,
   "end": 65.594,
   "line_starts": [
    59.112,
    61.732
   ],
   "subs": [
    {
     "start": 59.112,
     "end": 61.432,
     "text": "Thing number three. The twenty four hour rule."
    },
    {
     "start": 61.732,
     "end": 63.779,
     "text": "Anything you want that costs over fifty"
    },
    {
     "start": 63.779,
     "end": 65.144,
     "text": "dollars, you wait one day."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 65.594,
   "end": 69.17,
   "line_starts": [
    65.594
   ],
   "subs": [
    {
     "start": 65.594,
     "end": 67.157,
     "text": "Half the time, the next morning,"
    },
    {
     "start": 67.157,
     "end": 68.72,
     "text": "you didn't even want it anymore."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 69.17,
   "end": 74.844,
   "line_starts": [
    69.17,
    71.798
   ],
   "subs": [
    {
     "start": 69.17,
     "end": 70.646,
     "text": "Jake has a different rule."
    },
    {
     "start": 70.646,
     "end": 71.498,
     "text": "See it, buy it."
    },
    {
     "start": 71.798,
     "end": 73.478,
     "text": "His closet is full of things with"
    },
    {
     "start": 73.478,
     "end": 74.394,
     "text": "the tags still on."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 74.844,
   "end": 78.648,
   "line_starts": [
    74.844
   ],
   "subs": [
    {
     "start": 74.844,
     "end": 76.74,
     "text": "Thing number four. You cooked dinner at"
    },
    {
     "start": 76.74,
     "end": 78.198,
     "text": "home three more nights a week."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 78.648,
   "end": 87.875,
   "line_starts": [
    78.648,
    83.561
   ],
   "subs": [
    {
     "start": 78.648,
     "end": 80.871,
     "text": "A delivery dinner was costing you around"
    },
    {
     "start": 80.871,
     "end": 83.261,
     "text": "twenty five dollars. Cooking it, about ten."
    },
    {
     "start": 83.561,
     "end": 85.464,
     "text": "Fifteen dollars saved each time."
    },
    {
     "start": 85.464,
     "end": 87.425,
     "text": "Over two thousand dollars a year."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 87.875,
   "end": 94.496,
   "line_starts": [
    87.875,
    91.781
   ],
   "subs": [
    {
     "start": 87.875,
     "end": 90.474,
     "text": "Thing number five. You canceled two subscriptions"
    },
    {
     "start": 90.474,
     "end": 91.481,
     "text": "you forgot you had."
    },
    {
     "start": 91.781,
     "end": 92.993,
     "text": "Thirty dollars a month."
    },
    {
     "start": 92.993,
     "end": 94.046,
     "text": "Gone in ten minutes."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 94.496,
   "end": 101.182,
   "line_starts": [
    94.496,
    97.421
   ],
   "subs": [
    {
     "start": 94.496,
     "end": 97.121,
     "text": "Thing number six. One no spend day every week."
    },
    {
     "start": 97.421,
     "end": 99.108,
     "text": "Wednesdays. No coffee shop."
    },
    {
     "start": 99.108,
     "end": 100.732,
     "text": "No online orders. Nothing."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 101.182,
   "end": 106.612,
   "line_starts": [
    101.182,
    103.901
   ],
   "subs": [
    {
     "start": 101.182,
     "end": 103.601,
     "text": "It sounds tiny. But it taught you something big."
    },
    {
     "start": 103.901,
     "end": 106.162,
     "text": "Most of your spending was habit, not need."
    }
   ]
  },
  {
   "id": "s18",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 106.612,
   "end": 114.756,
   "line_starts": [
    106.612,
    110.442
   ],
   "subs": [
    {
     "start": 106.612,
     "end": 108.751,
     "text": "Thing number seven. You paid your credit"
    },
    {
     "start": 108.751,
     "end": 110.142,
     "text": "card in full. Every month."
    },
    {
     "start": 110.442,
     "end": 113.018,
     "text": "Card interest often runs over twenty percent"
    },
    {
     "start": 113.018,
     "end": 114.306,
     "text": "a year. You paid zero."
    }
   ]
  },
  {
   "id": "s19",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 114.756,
   "end": 120.322,
   "line_starts": [
    114.756,
    116.227
   ],
   "subs": [
    {
     "start": 114.756,
     "end": 115.927,
     "text": "Mia pays the minimum."
    },
    {
     "start": 116.227,
     "end": 118.076,
     "text": "Her balance hasn't moved all year,"
    },
    {
     "start": 118.076,
     "end": 119.872,
     "text": "even though she pays every month."
    }
   ]
  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 120.322,
   "end": 126.462,
   "line_starts": [
    120.322,
    122.758
   ],
   "subs": [
    {
     "start": 120.322,
     "end": 122.458,
     "text": "Thing number eight. Ten pages a day."
    },
    {
     "start": 122.758,
     "end": 123.786,
     "text": "Not a book a week."
    },
    {
     "start": 123.786,
     "end": 126.012,
     "text": "Just ten pages, every night before bed."
    }
   ]
  },
  {
   "id": "s21",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 126.462,
   "end": 133.823,
   "line_starts": [
    126.462,
    130.456
   ],
   "subs": [
    {
     "start": 126.462,
     "end": 128.502,
     "text": "That's over three thousand pages in a"
    },
    {
     "start": 128.502,
     "end": 130.156,
     "text": "year. More than a dozen books."
    },
    {
     "start": 130.456,
     "end": 132.015,
     "text": "A few of them were about money."
    },
    {
     "start": 132.015,
     "end": 133.373,
     "text": "They changed how you think."
    }
   ]
  },
  {
   "id": "s22",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 133.823,
   "end": 138.326,
   "line_starts": [
    133.823
   ],
   "subs": [
    {
     "start": 133.823,
     "end": 136.075,
     "text": "Thing number nine. A twenty minute walk,"
    },
    {
     "start": 136.075,
     "end": 137.876,
     "text": "every day. Phone in your pocket."
    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 138.326,
   "end": 143.806,
   "line_starts": [
    138.326,
    140.421
   ],
   "subs": [
    {
     "start": 138.326,
     "end": 140.121,
     "text": "You slept better. You stressed less."
    },
    {
     "start": 140.421,
     "end": 142.046,
     "text": "And stressed people spend more."
    },
    {
     "start": 142.046,
     "end": 143.356,
     "text": "That's not a coincidence."
    }
   ]
  },
  {
   "id": "s24",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 143.806,
   "end": 148.577,
   "line_starts": [
    143.806
   ],
   "subs": [
    {
     "start": 143.806,
     "end": 145.426,
     "text": "Thing number ten. The big one."
    },
    {
     "start": 145.426,
     "end": 146.993,
     "text": "When you got a raise in June,"
    },
    {
     "start": 146.993,
     "end": 148.127,
     "text": "you saved half of it."
    }
   ]
  },
  {
   "id": "s25",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 148.577,
   "end": 153.24,
   "line_starts": [
    148.577
   ],
   "subs": [
    {
     "start": 148.577,
     "end": 150.252,
     "text": "You still enjoyed the other half."
    },
    {
     "start": 150.252,
     "end": 152.79,
     "text": "But your lifestyle didn't jump with your paycheck."
    }
   ]
  },
  {
   "id": "s26",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 153.24,
   "end": 157.191,
   "line_starts": [
    153.24
   ],
   "subs": [
    {
     "start": 153.24,
     "end": 154.465,
     "text": "Jake got a raise too."
    },
    {
     "start": 154.465,
     "end": 156.741,
     "text": "A week later, he had a new car payment."
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 157.191,
   "end": 162.273,
   "line_starts": [
    157.191,
    159.851
   ],
   "subs": [
    {
     "start": 157.191,
     "end": 159.551,
     "text": "Here's what nobody tells you about small things."
    },
    {
     "start": 159.851,
     "end": 161.823,
     "text": "On their own, they don't feel like anything."
    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 162.273,
   "end": 169.317,
   "line_starts": [
    162.273,
    166.687
   ],
   "subs": [
    {
     "start": 162.273,
     "end": 164.448,
     "text": "Fifty dollars doesn't feel like much."
    },
    {
     "start": 164.448,
     "end": 166.387,
     "text": "Ten pages doesn't feel like much."
    },
    {
     "start": 166.687,
     "end": 168.867,
     "text": "But they stack. Every day. Every week."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 169.317,
   "end": 174.894,
   "line_starts": [
    169.317,
    172.529
   ],
   "subs": [
    {
     "start": 169.317,
     "end": 172.229,
     "text": "Big resolutions fail because they need motivation."
    },
    {
     "start": 172.529,
     "end": 174.444,
     "text": "Small habits work because they don't."
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 174.894,
   "end": 179.354,
   "line_starts": [
    174.894,
    176.074
   ],
   "subs": [
    {
     "start": 174.894,
     "end": 175.774,
     "text": "Let's add it up."
    },
    {
     "start": 176.074,
     "end": 178.904,
     "text": "Fifty a week. Cooking at home. Two subscriptions."
    }
   ]
  },
  {
   "id": "s31",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 179.354,
   "end": 185.402,
   "line_starts": [
    179.354,
    181.494
   ],
   "subs": [
    {
     "start": 179.354,
     "end": 181.194,
     "text": "That's about fifty three hundred dollars."
    },
    {
     "start": 181.494,
     "end": 183.246,
     "text": "And that's before the money you didn't"
    },
    {
     "start": 183.246,
     "end": 184.952,
     "text": "waste on things you'd have regretted."
    }
   ]
  },
  {
   "id": "s32",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 185.402,
   "end": 194.683,
   "line_starts": [
    185.402,
    192.627
   ],
   "subs": [
    {
     "start": 185.402,
     "end": 187.329,
     "text": "Put that in a high yield savings"
    },
    {
     "start": 187.329,
     "end": 189.196,
     "text": "account, and it can even earn a"
    },
    {
     "start": 189.196,
     "end": 191.002,
     "text": "bit of interest. Rates change,"
    },
    {
     "start": 191.002,
     "end": 192.327,
     "text": "nothing is guaranteed."
    },
    {
     "start": 192.627,
     "end": 194.233,
     "text": "But the real win isn't the money."
    }
   ]
  },
  {
   "id": "s33",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 194.683,
   "end": 201.443,
   "line_starts": [
    194.683,
    195.865
   ],
   "subs": [
    {
     "start": 194.683,
     "end": 195.565,
     "text": "It's the feeling."
    },
    {
     "start": 195.865,
     "end": 197.904,
     "text": "When your car needed new tires in"
    },
    {
     "start": 197.904,
     "end": 199.881,
     "text": "October, you just paid for them."
    },
    {
     "start": 199.881,
     "end": 200.993,
     "text": "No panic. No card."
    }
   ]
  },
  {
   "id": "s34",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 201.443,
   "end": 205.864,
   "line_starts": [
    201.443,
    204.181
   ],
   "subs": [
    {
     "start": 201.443,
     "end": 202.377,
     "text": "Back at the party,"
    },
    {
     "start": 202.377,
     "end": 203.881,
     "text": "Jake asks you how you did it."
    },
    {
     "start": 204.181,
     "end": 205.414,
     "text": "Did you get a big raise?"
    }
   ]
  },
  {
   "id": "s35",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 205.864,
   "end": 210.083,
   "line_starts": [
    205.864,
    207.34
   ],
   "subs": [
    {
     "start": 205.864,
