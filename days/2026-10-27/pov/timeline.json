{
 "title": "POV: You Earn $3,500 a Month and Never Run Out \u2014 Jake Earns $5,500 and Is Broke Again",
 "duration": 221.653,
 "scenes": [
  {
   "id": "s0",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 0.3,
   "end": 5.621,
   "line_starts": [
    0.3,
    3.31
   ],
   "subs": [
    {
     "start": 0.3,
     "end": 1.572,
     "text": "It's the twenty eighth."
    },
    {
     "start": 1.572,
     "end": 3.01,
     "text": "Rent is due in three days."
    },
    {
     "start": 3.31,
     "end": 4.407,
     "text": "You open your bank app."
    },
    {
     "start": 4.407,
     "end": 5.171,
     "text": "And you're calm."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 5.621,
   "end": 10.442,
   "line_starts": [
    5.621,
    7.767
   ],
   "subs": [
    {
     "start": 5.621,
     "end": 7.467,
     "text": "Then your phone buzzes. It's Jake."
    },
    {
     "start": 7.767,
     "end": 9.992,
     "text": "Can you spot me two hundred until Friday?"
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 10.442,
   "end": 16.377,
   "line_starts": [
    10.442,
    14.476
   ],
   "subs": [
    {
     "start": 10.442,
     "end": 11.65,
     "text": "Here's the funny part."
    },
    {
     "start": 11.65,
     "end": 14.176,
     "text": "Jake earns fifty five hundred dollars a month."
    },
    {
     "start": 14.476,
     "end": 15.927,
     "text": "You earn thirty five hundred."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 16.377,
   "end": 18.804,
   "line_starts": [
    16.377
   ],
   "subs": [
    {
     "start": 16.377,
     "end": 18.354,
     "text": "And he's the one who's broke. Again."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 18.804,
   "end": 26.367,
   "line_starts": [
    18.804,
    23.751
   ],
   "subs": [
    {
     "start": 18.804,
     "end": 20.991,
     "text": "Surveys keep finding that around half of"
    },
    {
     "start": 20.991,
     "end": 23.451,
     "text": "Americans say they live paycheck to paycheck."
    },
    {
     "start": 23.751,
     "end": 25.917,
     "text": "Even plenty of people with good salaries."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 26.367,
   "end": 31.088,
   "line_starts": [
    26.367,
    27.885
   ],
   "subs": [
    {
     "start": 26.367,
     "end": 27.585,
     "text": "You used to be one of them."
    },
    {
     "start": 27.885,
     "end": 29.558,
     "text": "Here's exactly how you got out."
    },
    {
     "start": 29.558,
     "end": 30.638,
     "text": "And how you can too."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 31.088,
   "end": 36.666,
   "line_starts": [
    31.088,
    32.8
   ],
   "subs": [
    {
     "start": 31.088,
     "end": 32.5,
     "text": "Two years ago, you were Jake."
    },
    {
     "start": 32.8,
     "end": 34.272,
     "text": "Payday felt like a party."
    },
    {
     "start": 34.272,
     "end": 36.216,
     "text": "The last week felt like survival."
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 36.666,
   "end": 40.934,
   "line_starts": [
    36.666,
    39.39
   ],
   "subs": [
    {
     "start": 36.666,
     "end": 39.09,
     "text": "Your account hit zero around day twenty six."
    },
    {
     "start": 39.39,
     "end": 40.484,
     "text": "Every single month."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 40.934,
   "end": 45.902,
   "line_starts": [
    40.934,
    43.802
   ],
   "subs": [
    {
     "start": 40.934,
     "end": 43.502,
     "text": "Then your car needed a six hundred dollar repair."
    },
    {
     "start": 43.802,
     "end": 45.452,
     "text": "It went straight onto a credit card."
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 45.902,
   "end": 53.478,
   "line_starts": [
    45.902,
    47.757
   ],
   "subs": [
    {
     "start": 45.902,
     "end": 47.457,
     "text": "That night, you finally saw it."
    },
    {
     "start": 47.757,
     "end": 49.425,
     "text": "The problem wasn't your income."
    },
    {
     "start": 49.425,
     "end": 50.931,
     "text": "It was that there was no gap"
    },
    {
     "start": 50.931,
     "end": 53.028,
     "text": "between what came in and what went out."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 53.478,
   "end": 60.347,
   "line_starts": [
    53.478,
    56.472
   ],
   "subs": [
    {
     "start": 53.478,
     "end": 56.172,
     "text": "So one Sunday, you wrote down every fixed bill."
    },
    {
     "start": 56.472,
     "end": 59.897,
     "text": "Rent. Phone. Insurance. Utilities. Minimum payments."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 60.347,
   "end": 66.089,
   "line_starts": [
    60.347,
    62.846
   ],
   "subs": [
    {
     "start": 60.347,
     "end": 62.546,
     "text": "Then you went through three months of bank statements."
    },
    {
     "start": 62.846,
     "end": 65.639,
     "text": "Every coffee. Every delivery. Every subscription."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 66.089,
   "end": 70.913,
   "line_starts": [
    66.089
   ],
   "subs": [
    {
     "start": 66.089,
     "end": 68.249,
     "text": "The result hurt. Food delivery alone was"
    },
    {
     "start": 68.249,
     "end": 70.463,
     "text": "about one hundred eighty dollars a month."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 70.913,
   "end": 76.187,
   "line_starts": [
    70.913,
    73.531
   ],
   "subs": [
    {
     "start": 70.913,
     "end": 73.231,
     "text": "Three streaming services you barely watched."
    },
    {
     "start": 73.531,
     "end": 75.737,
     "text": "And a gym you hadn't visited since March."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 76.187,
   "end": 85.017,
   "line_starts": [
    76.187,
    81.401
   ],
   "subs": [
    {
     "start": 76.187,
     "end": 77.613,
     "text": "You didn't cut all the fun."
    },
    {
     "start": 77.613,
     "end": 79.78,
     "text": "You kept one streaming service and cooked"
    },
    {
     "start": 79.78,
     "end": 81.101,
     "text": "a few more nights a week."
    },
    {
     "start": 81.401,
     "end": 83.748,
     "text": "Suddenly, about one hundred fifty dollars a"
    },
    {
     "start": 83.748,
     "end": 84.567,
     "text": "month was free."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 85.017,
   "end": 88.924,
   "line_starts": [
    85.017,
    87.409
   ],
   "subs": [
    {
     "start": 85.017,
     "end": 87.109,
     "text": "Next came the rule that changed everything."
    },
    {
     "start": 87.409,
     "end": 88.474,
     "text": "Pay yourself first."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 88.924,
   "end": 95.761,
   "line_starts": [
    88.924,
    91.73
   ],
   "subs": [
    {
     "start": 88.924,
     "end": 91.43,
     "text": "On payday, ten percent leaves automatically."
    },
    {
     "start": 91.73,
     "end": 93.183,
     "text": "Three hundred fifty dollars,"
    },
    {
     "start": 93.183,
     "end": 95.311,
     "text": "straight into a separate savings account."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 95.761,
   "end": 101.059,
   "line_starts": [
    95.761,
    97.837
   ],
   "subs": [
    {
     "start": 95.761,
     "end": 97.537,
     "text": "Add the one hundred fifty you freed up."
    },
    {
     "start": 97.837,
     "end": 99.839,
     "text": "That's five hundred dollars a month you"
    },
    {
     "start": 99.839,
     "end": 100.609,
     "text": "never even see."
    }
   ]
  },
  {
   "id": "s18",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 101.059,
   "end": 106.588,
   "line_starts": [
    101.059,
    102.664
   ],
   "subs": [
    {
     "start": 101.059,
     "end": 102.364,
     "text": "Jake does the opposite."
    },
    {
     "start": 102.664,
     "end": 104.828,
     "text": "He spends first, and saves whatever is"
    },
    {
     "start": 104.828,
     "end": 106.138,
     "text": "left. Which is nothing."
    }
   ]
  },
  {
   "id": "s19",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 106.588,
   "end": 111.573,
   "line_starts": [
    106.588,
    108.095
   ],
   "subs": [
    {
     "start": 106.588,
     "end": 107.795,
     "text": "Your first goal was small."
    },
    {
     "start": 108.095,
     "end": 111.123,
     "text": "One thousand dollars. A starter emergency fund."
    }
   ]
  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 111.573,
   "end": 116.011,
   "line_starts": [
    111.573,
    113.269
   ],
   "subs": [
    {
     "start": 111.573,
     "end": 112.969,
     "text": "Two months later, you hit it."
    },
    {
     "start": 113.269,
     "end": 114.288,
     "text": "And then, of course,"
    },
    {
     "start": 114.288,
     "end": 115.561,
     "text": "the car broke down again."
    }
   ]
  },
  {
   "id": "s21",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 116.011,
   "end": 120.758,
   "line_starts": [
    116.011,
    117.844
   ],
   "subs": [
    {
     "start": 116.011,
     "end": 117.544,
     "text": "This time, you paid in cash."
    },
    {
     "start": 117.844,
     "end": 120.308,
     "text": "No credit card. No panic. Just paid."
    }
   ]
  },
  {
   "id": "s22",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 120.758,
   "end": 126.516,
   "line_starts": [
    120.758,
    123.177
   ],
   "subs": [
    {
     "start": 120.758,
     "end": 122.877,
     "text": "Jake got a surprise bill that same month."
    },
    {
     "start": 123.177,
     "end": 124.288,
     "text": "It went on his card,"
    },
    {
     "start": 124.288,
     "end": 126.066,
     "text": "at over twenty percent interest."
    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 126.516,
   "end": 129.784,
   "line_starts": [
    126.516,
    128.082
   ],
   "subs": [
    {
     "start": 126.516,
     "end": 127.782,
     "text": "Then you set a bigger goal."
    },
    {
     "start": 128.082,
     "end": 129.334,
     "text": "Get one full month ahead."
    }
   ]
  },
  {
   "id": "s24",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 129.784,
   "end": 135.348,
   "line_starts": [
    129.784,
    133.34
   ],
   "subs": [
    {
     "start": 129.784,
     "end": 131.779,
     "text": "That means this month's bills get paid"
    },
    {
     "start": 131.779,
     "end": 133.04,
     "text": "with last month's money."
    },
    {
     "start": 133.34,
     "end": 134.898,
     "text": "Payday stops being a rescue."
    }
   ]
  },
  {
   "id": "s25",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 135.348,
   "end": 140.692,
   "line_starts": [
    135.348
   ],
   "subs": [
    {
     "start": 135.348,
     "end": 136.653,
     "text": "At five hundred a month,"
    },
    {
     "start": 136.653,
     "end": 139.209,
     "text": "saving another thirty five hundred dollars took"
    },
    {
     "start": 139.209,
     "end": 140.242,
     "text": "about seven months."
    }
   ]
  },
  {
   "id": "s26",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 140.692,
   "end": 146.303,
   "line_starts": [
    140.692,
    143.827
   ],
   "subs": [
    {
     "start": 140.692,
     "end": 142.273,
     "text": "It wasn't exciting. Honestly,"
    },
    {
     "start": 142.273,
     "end": 143.527,
     "text": "it was a little boring."
    },
    {
     "start": 143.827,
     "end": 145.853,
     "text": "But every month, the cushion got bigger."
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 146.303,
   "end": 150.202,
   "line_starts": [
    146.303,
    147.923
   ],
   "subs": [
    {
     "start": 146.303,
     "end": 147.623,
     "text": "And then one day it happened."
    },
    {
     "start": 147.923,
     "end": 149.752,
     "text": "Payday came, and you didn't need it."
    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 150.202,
   "end": 154.336,
   "line_starts": [
    150.202
   ],
   "subs": [
    {
     "start": 150.202,
     "end": 152.126,
     "text": "One last trick. You opened a second"
    },
    {
     "start": 152.126,
     "end": 153.886,
     "text": "checking account just for bills."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 154.336,
   "end": 160.82,
   "line_starts": [
    154.336,
    157.752
   ],
   "subs": [
    {
     "start": 154.336,
     "end": 156.468,
     "text": "Every payday, the exact amount for your"
    },
    {
     "start": 156.468,
     "end": 157.452,
     "text": "bills moves there."
    },
    {
     "start": 157.752,
     "end": 160.37,
     "text": "Rent and utilities come out of it automatically."
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 160.82,
   "end": 166.71,
   "line_starts": [
    160.82,
    164.099
   ],
   "subs": [
    {
     "start": 160.82,
     "end": 162.824,
     "text": "Whatever is left in your main account"
    },
    {
     "start": 162.824,
     "end": 163.799,
     "text": "is yours to spend."
    },
    {
     "start": 164.099,
     "end": 166.26,
     "text": "No mental math. No surprises."
    }
   ]
  },
  {
   "id": "s31",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 166.71,
   "end": 171.112,
   "line_starts": [
    166.71,
    168.302
   ],
   "subs": [
    {
     "start": 166.71,
     "end": 168.002,
     "text": "Fast forward one year."
    },
    {
     "start": 168.302,
     "end": 170.662,
     "text": "Your company cuts overtime for three months."
    }
   ]
  },
  {
   "id": "s32",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 171.112,
   "end": 176.247,
   "line_starts": [
    171.112,
    173.559
   ],
   "subs": [
    {
     "start": 171.112,
     "end": 173.259,
     "text": "Jake panics. His card is maxed out."
    },
    {
     "start": 173.559,
     "end": 175.797,
     "text": "He's picking up weekend shifts just to keep up."
    }
   ]
  },
  {
   "id": "s33",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 176.247,
   "end": 180.7,
   "line_starts": [
    176.247,
    178.828
   ],
   "subs": [
    {
     "start": 176.247,
     "end": 177.857,
     "text": "You? You trim your spending a little"
    },
    {
     "start": 177.857,
     "end": 178.528,
     "text": "and keep going."
    },
    {
     "start": 178.828,
     "end": 180.25,
     "text": "Your cushion covers the gap."
    }
   ]
  },
  {
   "id": "s34",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 180.7,
   "end": 188.241,
   "line_starts": [
    180.7,
    184.184
   ],
   "subs": [
    {
     "start": 180.7,
     "end": 182.011,
     "text": "Same city. Same rent."
    },
    {
     "start": 182.011,
     "end": 183.884,
     "text": "Jake even earns more than you."
    },
    {
     "start": 184.184,
     "end": 186.114,
     "text": "The only difference is the gap between"
    },
    {
     "start": 186.114,
     "end": 187.791,
     "text": "what comes in, and what goes out."
    }
   ]
  },
  {
   "id": "s35",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 188.241,
   "end": 193.736,
   "line_starts": [
    188.241,
    189.581
   ],
   "subs": [
    {
     "start": 188.241,
     "end": 189.281,
     "text": "So here's your plan."
    },
    {
     "start": 189.581,
     "end": 191.606,
     "text": "This weekend, write down your fixed bills"
    },
    {
     "start": 191.606,
     "end": 193.286,
     "text": "and look at last month's spending."
    }
   ]
  },
  {
   "id": "s36",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 193.736,
   "end": 197.227,
   "line_starts": [
    193.736,
    195.544
   ],
   "subs": [
    {
     "start": 193.736,
     "end": 195.244,
     "text": "Find three leaks you won't miss."
    },
    {
     "start": 195.544,
     "end": 196.777,
     "text": "And cancel them tonight."
    }
   ]
  },
  {
   "id": "s37",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 197.227,
   "end": 201.951,
   "line_starts": [
    197.227,
    199.99
   ],
   "subs": [
    {
     "start": 197.227,
     "end": 199.69,
     "text": "Then set up an automatic transfer for payday."
    },
    {
     "start": 199.99,
     "end": 201.501,
     "text": "Even fifty dollars counts."
    }
