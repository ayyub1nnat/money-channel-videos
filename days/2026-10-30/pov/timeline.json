   ],
   "subs": [
    {
     "start": 0.1,
     "end": 1.969,
     "text": "It's six thirty in the morning."
    },
    {
     "start": 1.969,
     "end": 3.658,
     "text": "Your alarm goes off... once."
    },
    {
     "start": 3.838,
     "end": 5.106,
     "text": "And you actually get up."
    },
    {
     "start": 5.286,
     "end": 6.762,
     "text": "No snooze. No panic."
    },
    {
     "start": 6.762,
     "end": 8.827,
     "text": "No racing heart. Just... up."
    },
    {
     "start": 9.007,
     "end": 10.905,
     "text": "You even have time to make the bed."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 11.185,
   "end": 24.434,
   "line_starts": [
    11.185,
    15.199,
    17.503,
    20.637
   ],
   "subs": [
    {
     "start": 11.185,
     "end": 13.674,
     "text": "Across town, Jake's alarm goes off at"
    },
    {
     "start": 13.674,
     "end": 15.019,
     "text": "the exact same time."
    },
    {
     "start": 15.199,
     "end": 17.323,
     "text": "He hits snooze. Then again. And again."
    },
    {
     "start": 17.503,
     "end": 19.666,
     "text": "Every nine minutes, the same little fight"
    },
    {
     "start": 19.666,
     "end": 20.457,
     "text": "with his phone."
    },
    {
     "start": 20.637,
     "end": 22.759,
     "text": "And every time, he tells himself..."
    },
    {
     "start": 22.759,
     "end": 24.154,
     "text": "just five more minutes."
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 24.434,
   "end": 32.639,
   "line_starts": [
    24.434,
    28.104,
    29.827
   ],
   "subs": [
    {
     "start": 24.434,
     "end": 26.241,
     "text": "By the time he opens his eyes"
    },
    {
     "start": 26.241,
     "end": 27.924,
     "text": "for real, it's eight fifty."
    },
    {
     "start": 28.104,
     "end": 29.647,
     "text": "His meeting starts at nine."
    },
    {
     "start": 29.827,
     "end": 32.359,
     "text": "He's late. Again. Third time this month."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 32.639,
   "end": 45.379,
   "line_starts": [
    32.639,
    34.86,
    37.315,
    40.765
   ],
   "subs": [
    {
     "start": 32.639,
     "end": 34.68,
     "text": "And here's the thing nobody tells you."
    },
    {
     "start": 34.86,
     "end": 37.135,
     "text": "Jake's messy morning isn't just stressful."
    },
    {
     "start": 37.315,
     "end": 38.761,
     "text": "It's costing him money."
    },
    {
     "start": 38.761,
     "end": 40.585,
     "text": "Real money. Every single day."
    },
    {
     "start": 40.765,
     "end": 43.087,
     "text": "Not in one big painful moment."
    },
    {
     "start": 43.087,
     "end": 45.099,
     "text": "In tiny, invisible pieces."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 45.379,
   "end": 57.395,
   "line_starts": [
    45.379,
    49.779,
    53.758
   ],
   "subs": [
    {
     "start": 45.379,
     "end": 47.204,
     "text": "Stay with me, because by the end"
    },
    {
     "start": 47.204,
     "end": 49.599,
     "text": "of this story you'll see exactly how much."
    },
    {
     "start": 49.779,
     "end": 51.973,
     "text": "And the simple morning routine that makes"
    },
    {
     "start": 51.973,
     "end": 53.578,
     "text": "you calmer, more productive..."
    },
    {
     "start": 53.758,
     "end": 57.115,
     "text": "and about three thousand dollars richer every single year."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 57.395,
   "end": 71.025,
   "line_starts": [
    57.395,
    60.798,
    64.114,
    66.897
   ],
   "subs": [
    {
     "start": 57.395,
     "end": 59.522,
     "text": "So let's rewind. Let's go back to"
    },
    {
     "start": 59.522,
     "end": 60.618,
     "text": "the night before."
    },
    {
     "start": 60.798,
     "end": 63.15,
     "text": "Because a good morning doesn't actually start"
    },
    {
     "start": 63.15,
     "end": 63.934,
     "text": "in the morning."
    },
    {
     "start": 64.114,
     "end": 66.717,
     "text": "It starts around nine thirty the evening before."
    },
    {
     "start": 66.897,
     "end": 68.726,
     "text": "Sounds boring? Stick with me."
    },
    {
     "start": 68.726,
     "end": 70.745,
     "text": "This is where the magic happens."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 71.025,
   "end": 79.368,
   "line_starts": [
    71.025,
    73.028,
    75.486
   ],
   "subs": [
    {
     "start": 71.025,
     "end": 72.848,
     "text": "You give it ten minutes. That's all."
    },
    {
     "start": 73.028,
     "end": 75.306,
     "text": "You lay out tomorrow's clothes on the chair."
    },
    {
     "start": 75.486,
     "end": 76.611,
     "text": "You pack your lunch."
    },
    {
     "start": 76.611,
     "end": 79.088,
     "text": "You fill the coffee maker and set the timer."
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 79.368,
   "end": 93.653,
   "line_starts": [
    79.368,
    83.149,
    85.092,
    89.563
   ],
   "subs": [
    {
     "start": 79.368,
     "end": 81.895,
     "text": "Keys, wallet, badge... all in one little"
    },
    {
     "start": 81.895,
     "end": 82.969,
     "text": "bowl by the door."
    },
    {
     "start": 83.149,
     "end": 84.912,
     "text": "It feels almost too simple, right?"
    },
    {
     "start": 85.092,
     "end": 87.21,
     "text": "But every decision you make tonight is"
    },
    {
     "start": 87.21,
     "end": 89.383,
     "text": "one you don't have to make half asleep."
    },
    {
     "start": 89.563,
     "end": 91.038,
     "text": "No searching. No stress."
    },
    {
     "start": 91.038,
     "end": 93.373,
     "text": "Everything is right where you left it."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 93.653,
   "end": 101.887,
   "line_starts": [
    93.653,
    96.167,
    98.639
   ],
   "subs": [
    {
     "start": 93.653,
     "end": 95.336,
     "text": "And then you do one more thing."
    },
    {
     "start": 95.336,
     "end": 95.987,
     "text": "The big one."
    },
    {
     "start": 96.167,
     "end": 97.564,
     "text": "You plug your phone in..."
    },
    {
     "start": 97.564,
     "end": 98.459,
     "text": "across the room."
    },
    {
     "start": 98.639,
     "end": 99.723,
     "text": "Not on your pillow."
    },
    {
     "start": 99.723,
     "end": 100.694,
     "text": "Not in your hand."
    },
    {
     "start": 100.694,
     "end": 101.607,
     "text": "Across the room."
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 101.887,
   "end": 111.584,
   "line_starts": [
    101.887,
    106.548,
    107.958
   ],
   "subs": [
    {
     "start": 101.887,
     "end": 104.217,
     "text": "Why? Because now, when the alarm rings,"
    },
    {
     "start": 104.217,
     "end": 106.368,
     "text": "you have to stand up to turn it off."
    },
    {
     "start": 106.548,
     "end": 107.778,
     "text": "And once you're standing?"
    },
    {
     "start": 107.958,
     "end": 110.397,
     "text": "Honestly... the hardest part of the morning"
    },
    {
     "start": 110.397,
     "end": 111.304,
     "text": "is already over."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 111.584,
   "end": 122.929,
   "line_starts": [
    111.584,
    113.942,
    116.733,
    118.881
   ],
   "subs": [
    {
     "start": 111.584,
     "end": 113.762,
     "text": "Meanwhile, Jake is in bed. Scrolling."
    },
    {
     "start": 113.942,
     "end": 116.553,
     "text": "Eleven thirty. Midnight. Twelve forty."
    },
    {
     "start": 116.733,
     "end": 118.701,
     "text": "One more video. Just one more."
    },
    {
     "start": 118.881,
     "end": 120.555,
     "text": "His brain is wide awake."
    },
    {
     "start": 120.555,
     "end": 122.649,
     "text": "His body is begging for sleep."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 122.929,
   "end": 134.9,
   "line_starts": [
    122.929,
    126.023,
    128.939,
    132.283
   ],
   "subs": [
    {
     "start": 122.929,
     "end": 124.926,
     "text": "Most adults need at least seven hours"
    },
    {
     "start": 124.926,
     "end": 125.843,
     "text": "of sleep a night."
    },
    {
     "start": 126.023,
     "end": 127.188,
     "text": "Jake gets about six."
    },
    {
     "start": 127.188,
     "end": 128.759,
     "text": "And that's on a good night."
    },
    {
     "start": 128.939,
     "end": 130.895,
     "text": "He doesn't feel tired at midnight."
    },
    {
     "start": 130.895,
     "end": 132.103,
     "text": "He feels it at seven."
    },
    {
     "start": 132.283,
     "end": 134.62,
     "text": "So every morning starts with a little sleep debt."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 134.9,
   "end": 143.853,
   "line_starts": [
    134.9,
    138.904,
    141.428
   ],
   "subs": [
    {
     "start": 134.9,
     "end": 136.134,
     "text": "So the next morning,"
    },
    {
     "start": 136.134,
     "end": 138.724,
     "text": "that snooze button feels like a lifesaver."
    },
    {
     "start": 138.904,
     "end": 140.157,
     "text": "Just nine more minutes."
    },
    {
     "start": 140.157,
     "end": 141.248,
     "text": "What could go wrong?"
    },
    {
     "start": 141.428,
     "end": 142.877,
     "text": "But it isn't a lifesaver."
    },
    {
     "start": 142.877,
     "end": 143.573,
     "text": "It's a trap."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 143.853,
   "end": 151.775,
   "line_starts": [
    143.853,
    146.834,
    149.127
   ],
   "subs": [
    {
     "start": 143.853,
     "end": 146.654,
     "text": "Those extra minutes don't give you real, deep rest."
    },
    {
     "start": 146.834,
     "end": 148.243,
     "text": "You just drift in and out,"
    },
    {
     "start": 148.243,
     "end": 148.947,
     "text": "in and out..."
    },
    {
     "start": 149.127,
     "end": 151.495,
     "text": "and you wake up even groggier than before."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 151.775,
   "end": 164.002,
   "line_starts": [
    151.775,
    153.474,
    157.144,
    160.477
   ],
   "subs": [
    {
     "start": 151.775,
     "end": 153.294,
     "text": "And then the scramble begins."
    },
    {
     "start": 153.474,
     "end": 155.314,
     "text": "No clean shirt. No breakfast."
    },
    {
     "start": 155.314,
     "end": 156.964,
     "text": "Keys? Where are the keys?!"
    },
    {
     "start": 157.144,
     "end": 159.443,
     "text": "He finds them in yesterday's jeans."
    },
    {
     "start": 159.443,
     "end": 160.297,
     "text": "On the floor."
    },
    {
     "start": 160.477,
     "end": 162.527,
     "text": "His heart is pounding before he even"
    },
    {
     "start": 162.527,
     "end": 163.722,
     "text": "leaves the apartment."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 164.002,
   "end": 171.175,
   "line_starts": [
    164.002,
    165.973,
    168.912
   ],
   "subs": [
    {
     "start": 164.002,
     "end": 165.793,
     "text": "He runs out the door with nothing."
    },
    {
     "start": 165.973,
     "end": 167.317,
     "text": "No coffee. No food."
    },
    {
     "start": 167.317,
     "end": 168.732,
     "text": "No plan for the day."
    },
    {
     "start": 168.912,
     "end": 170.895,
     "text": "Just stress. And a growing headache."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 171.175,
   "end": 181.018,
   "line_starts": [
    171.175,
    173.949,
    176.66,
    177.676
   ],
   "subs": [
    {
     "start": 171.175,
     "end": 173.769,
     "text": "And that's exactly where his wallet starts bleeding."
    },
    {
     "start": 173.949,
     "end": 176.48,
     "text": "Quietly. Politely. Every single morning."
    },
    {
     "start": 176.66,
     "end": 177.496,
     "text": "Watch this."
    },
    {
     "start": 177.676,
     "end": 178.734,
     "text": "And the worst part?"
    },
    {
     "start": 178.734,
     "end": 180.738,
     "text": "He doesn't even notice it happening."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 181.018,
   "end": 189.27,
   "line_starts": [
    181.018,
    183.989,
    186.847
   ],
   "subs": [
    {
     "start": 181.018,
     "end": 183.809,
     "text": "Stop number one: the coffee shop on the corner."
    },
    {
     "start": 183.989,
     "end": 185.503,
     "text": "There's a line, of course."
    },
    {
     "start": 185.503,
     "end": 186.667,
     "text": "He's even later now."
    },
    {
     "start": 186.847,
     "end": 188.99,
     "text": "A large latte. Six dollars."
    }
   ]
  },
  {
   "id": "s18",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 189.27,
   "end": 196.31,
   "line_starts": [
    189.27,
    193.044,
    195.159
   ],
   "subs": [
    {
     "start": 189.27,
     "end": 191.546,
     "text": "Stop number two: a breakfast sandwich,"
    },
    {
     "start": 191.546,
     "end": 192.864,
     "text": "because he's starving."
    },
    {
     "start": 193.044,
     "end": 194.979,
     "text": "He eats it in four bites, walking."
    },
    {
     "start": 195.159,
     "end": 196.03,
     "text": "Eight dollars."
    }
   ]
  },
  {
   "id": "s19",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 196.31,
   "end": 205.935,
   "line_starts": [
    196.31,
    199.185,
    200.86,
    203.15
   ],
   "subs": [
    {
     "start": 196.31,
     "end": 199.005,
     "text": "Fourteen dollars. Gone before nine A M."
    },
    {
     "start": 199.185,
     "end": 200.68,
     "text": "Does that sound like a lot?"
    },
    {
     "start": 200.86,
     "end": 202.97,
     "text": "Not really, right? It's just breakfast."
    },
    {
     "start": 203.15,
     "end": 205.655,
     "text": "And honestly, Jake would say the same thing."
    }
   ]
  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 205.935,
   "end": 215.045,
   "line_starts": [
    205.935,
    209.344,
    211.4
   ],
   "subs": [
    {
     "start": 205.935,
     "end": 207.251,
     "text": "But let's do the math."
    },
    {
     "start": 207.251,
     "end": 209.164,
     "text": "Fourteen dollars, every workday."
    },
    {
     "start": 209.344,
     "end": 211.22,
     "text": "About twenty one workdays a month."
    },
    {
     "start": 211.4,
     "end": 214.765,
     "text": "That's roughly two hundred ninety four dollars. Every month."
    }
   ]
  },
  {
   "id": "s21",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 215.045,
   "end": 227.525,
   "line_starts": [
    215.045,
    218.844,
    222.595,
    225.736
   ],
   "subs": [
    {
     "start": 215.045,
     "end": 216.087,
     "text": "Over a full year?"
    },
    {
     "start": 216.087,
     "end": 218.664,
     "text": "About three thousand five hundred dollars."
    },
    {
     "start": 218.844,
     "end": 222.415,
     "text": "Gone. On coffee and sandwiches he barely even tasted."
    },
    {
     "start": 222.595,
     "end": 225.556,
     "text": "That's a vacation. That's an emergency fund. Gone."
    },
    {
     "start": 225.736,
     "end": 227.245,
     "text": "Think about that for a second."
    }
   ]
  },
  {
   "id": "s22",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 227.525,
   "end": 238.185,
   "line_starts": [
    227.525,
    228.959,
    230.925,
    234.88
   ],
   "subs": [
    {
     "start": 227.525,
     "end": 228.779,
     "text": "And you know what's worse?"
    },
    {
     "start": 228.959,
     "end": 230.745,
     "text": "Jake isn't even enjoying it."
    },
    {
     "start": 230.925,
     "end": 232.363,
     "text": "He's eating at his desk,"
    },
    {
     "start": 232.363,
     "end": 234.7,
     "text": "stressed, already behind on everything."
    },
    {
     "start": 234.88,
     "end": 236.363,
     "text": "By lunch, he's exhausted."
    },
    {
     "start": 236.363,
     "end": 237.905,
     "text": "And he's buying lunch too."
    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 238.185,
   "end": 246.979,
   "line_starts": [
    238.185,
    239.848,
    243.301
   ],
   "subs": [
    {
     "start": 238.185,
     "end": 239.668,
     "text": "Now. Let's look at your morning."
    },
    {
     "start": 239.848,
     "end": 241.406,
     "text": "Same city. Same job."
    },
    {
     "start": 241.406,
     "end": 243.121,
     "text": "Same paycheck as Jake."
    },
    {
     "start": 243.301,
     "end": 245.35,
     "text": "The only difference is what happens in"
    },
    {
     "start": 245.35,
     "end": 246.699,
     "text": "the first thirty minutes."
    }
   ]
  },
  {
   "id": "s24",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 246.979,
   "end": 260.389,
   "line_starts": [
    246.979,
    250.127,
    251.774,
    256.022
   ],
   "subs": [
    {
     "start": 246.979,
     "end": 248.463,
     "text": "You get up at six thirty."
    },
    {
     "start": 248.463,
     "end": 249.947,
     "text": "You walk across the room."
    },
    {
     "start": 250.127,
     "end": 251.594,
     "text": "You switch off the alarm."
    },
    {
     "start": 251.774,
     "end": 253.604,
     "text": "And then you do something that feels"
    },
    {
     "start": 253.604,
     "end": 255.842,
     "text": "weird at first... you leave the phone there."
    },
    {
     "start": 256.022,
     "end": 258.244,
     "text": "No notifications. No headlines."
    },
    {
     "start": 258.244,
     "end": 260.109,
     "text": "Just you and a quiet room."
    }
   ]
  },
  {
   "id": "s25",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 260.389,
   "end": 271.59,
   "line_starts": [
    260.389,
    264.691,
    268.221
   ],
   "subs": [
    {
     "start": 260.389,
     "end": 262.622,
     "text": "Because the second you open your phone,"
    },
    {
     "start": 262.622,
     "end": 264.511,
     "text": "your morning isn't yours anymore."
    },
    {
     "start": 264.691,
     "end": 266.433,
     "text": "Emails. News. Group chats."
    },
    {
     "start": 266.433,
     "end": 268.041,
     "text": "Other people's problems."
    },
    {
     "start": 268.221,
     "end": 269.958,
     "text": "You haven't even brushed your teeth,"
    },
    {
     "start": 269.958,
     "end": 271.31,
     "text": "and you're already stressed."
    }
   ]
  },
  {
   "id": "s26",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 271.59,
   "end": 282.5,
   "line_starts": [
    271.59,
    274.436,
    277.1,
    279.477
   ],
   "subs": [
    {
     "start": 271.59,
     "end": 274.256,
     "text": "So instead, you drink a big glass of water."
    },
    {
     "start": 274.436,
     "end": 275.678,
     "text": "You open the window."
    },
    {
     "start": 275.678,
     "end": 276.92,
     "text": "Cold air. Fresh air."
    },
    {
     "start": 277.1,
     "end": 279.297,
     "text": "Five slow, deep breaths. That's it."
    },
    {
     "start": 279.477,
     "end": 280.78,
     "text": "Your body wakes up."
    },
    {
     "start": 280.78,
     "end": 282.22,
     "text": "Your mind slows down."
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 282.5,
   "end": 291.639,
   "line_starts": [
    282.5,
    284.461,
    288.618
   ],
   "subs": [
    {
     "start": 282.5,
     "end": 284.281,
     "text": "Then you move. Just ten minutes."
    },
    {
     "start": 284.461,
     "end": 285.929,
     "text": "A walk around the block."
    },
    {
     "start": 285.929,
     "end": 288.438,
     "text": "A few stretches on the living room floor."
    },
    {
     "start": 288.618,
     "end": 290.293,
     "text": "Nothing fancy. No gym."
    },
    {
     "start": 290.293,
     "end": 291.359,
     "text": "No fancy gear."
    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 291.639,
   "end": 304.725,
   "line_starts": [
    291.639,
    293.867,
    297.135,
    300.037
   ],
   "subs": [
    {
     "start": 291.639,
     "end": 293.687,
     "text": "You're not training for a marathon here."
    },
    {
     "start": 293.867,
     "end": 295.697,
     "text": "You're just telling your body..."
    },
    {
     "start": 295.697,
     "end": 296.955,
     "text": "hey. It's daytime now."
    },
    {
     "start": 297.135,
     "end": 298.683,
     "text": "And by the time you get back,"
    },
    {
     "start": 298.683,
     "end": 299.857,
     "text": "your head feels clear."
    },
    {
     "start": 300.037,
     "end": 302.493,
     "text": "Some mornings you even see the sunrise."
    },
    {
     "start": 302.493,
     "end": 304.445,
     "text": "Jake hasn't seen one in months."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 304.725,
   "end": 313.351,
   "line_starts": [
    304.725,
    307.483,
    310.019
   ],
   "subs": [
    {
     "start": 304.725,
     "end": 307.303,
     "text": "Back home, the coffee's already ready and waiting."
    },
    {
     "start": 307.483,
     "end": 309.839,
     "text": "Because you set it up last night. Remember?"
    },
    {
     "start": 310.019,
     "end": 312.413,
     "text": "That smell. Honestly, it's the best part"
    },
    {
     "start": 312.413,
     "end": 313.071,
     "text": "of the day."
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 313.351,
   "end": 325.503,
   "line_starts": [
    313.351,
    316.255,
    319.615,
    321.994
   ],
   "subs": [
    {
     "start": 313.351,
     "end": 315.394,
     "text": "Coffee at home costs you about fifty"
    },
    {
     "start": 315.394,
     "end": 316.075,
     "text": "cents a cup."
    },
    {
     "start": 316.255,
     "end": 317.713,
     "text": "Oatmeal with a banana?"
    },
    {
     "start": 317.713,
     "end": 319.435,
     "text": "Maybe another fifty cents."
    },
    {
     "start": 319.615,
     "end": 321.814,
     "text": "So breakfast costs you about one dollar."
    },
    {
     "start": 321.994,
     "end": 322.979,
     "text": "And you know what?"
    },
    {
     "start": 322.979,
     "end": 325.223,
     "text": "It tastes better than the six dollar one."
    }
   ]
  },
  {
   "id": "s31",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 325.503,
   "end": 336.04,
   "line_starts": [
    325.503,
    328.95,
    332.248
   ],
   "subs": [
    {
     "start": 325.503,
     "end": 327.074,
     "text": "One dollar. Sitting down."
    },
    {
     "start": 327.074,
     "end": 328.77,
     "text": "Actually tasting your food."
    },
    {
     "start": 328.95,
     "end": 332.068,
     "text": "Versus Jake's fourteen dollar sprint down the sidewalk."
    },
    {
     "start": 332.248,
     "end": 334.394,
     "text": "Same caffeine. Same full stomach."
    },
    {
     "start": 334.394,
     "end": 335.76,
     "text": "Very different price."
    }
   ]
  },
  {
   "id": "s32",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 336.04,
   "end": 343.444,
   "line_starts": [
    336.04,
    338.7,
    341.734
   ],
   "subs": [
    {
     "start": 336.04,
     "end": 338.52,
     "text": "And now comes the part that changes everything."
    },
    {
     "start": 338.7,
     "end": 339.975,
     "text": "It takes ten minutes."
    },
    {
     "start": 339.975,
     "end": 341.554,
     "text": "And almost nobody does it."
    },
    {
     "start": 341.734,
     "end": 343.164,
     "text": "The ten minute money check."
    }
   ]
  },
  {
   "id": "s33",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 343.444,
   "end": 354.694,
   "line_starts": [
    343.444,
    346.227,
    348.26,
    351.279
   ],
   "subs": [
    {
     "start": 343.444,
     "end": 344.982,
     "text": "Now you pick up the phone."
    },
    {
     "start": 344.982,
     "end": 346.047,
     "text": "But only for this."
    },
    {
     "start": 346.227,
     "end": 348.08,
     "text": "Minute one: you look at your balance."
    },
    {
     "start": 348.26,
     "end": 349.679,
     "text": "No fear. No guessing."
    },
    {
     "start": 349.679,
     "end": 351.099,
     "text": "Just the real number."
    },
    {
     "start": 351.279,
     "end": 353.046,
     "text": "Ten minutes. One cup of coffee."
    },
    {
     "start": 353.046,
     "end": 354.414,
     "text": "That's the whole system."
    }
   ]
  },
  {
   "id": "s34",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 354.694,
   "end": 363.276,
   "line_starts": [
    354.694,
    357.762,
    360.803
   ],
   "subs": [
    {
     "start": 354.694,
     "end": 356.374,
     "text": "Next: you check what came out of"
    },
    {
     "start": 356.374,
     "end": 357.582,
     "text": "your account yesterday."
    },
    {
     "start": 357.762,
     "end": 360.623,
     "text": "Anything weird? A charge you don't recognize?"
    },
    {
     "start": 360.803,
     "end": 362.996,
     "text": "Most days, it's nothing. But today..."
    }
   ]
  },
  {
   "id": "s35",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 363.276,
   "end": 376.389,
   "line_starts": [
    363.276,
    364.831,
    369.704,
    372.436
   ],
   "subs": [
    {
     "start": 363.276,
     "end": 364.651,
     "text": "Today, you catch something."
    },
    {
     "start": 364.831,
     "end": 366.733,
     "text": "A free trial you forgot about."
    },
    {
     "start": 366.733,
     "end": 369.524,
     "text": "It just turned into a fifteen dollar charge."
    },
    {
     "start": 369.704,
     "end": 372.256,
     "text": "And it would've kept charging you. Every month."
    },
    {
     "start": 372.436,
     "end": 374.762,
     "text": "Fifteen dollars a month is one hundred"
    },
    {
     "start": 374.762,
     "end": 376.109,
     "text": "eighty dollars a year."
    }
   ]
  },
  {
   "id": "s36",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 376.389,
   "end": 386.205,
   "line_starts": [
    376.389,
    378.902,
    380.875,
    382.941
   ],
   "subs": [
    {
     "start": 376.389,
     "end": 378.722,
     "text": "You cancel it. Right there. Thirty seconds."
    },
    {
     "start": 378.902,
     "end": 380.695,
     "text": "Fifteen dollars a month, saved..."
    },
    {
     "start": 380.875,
     "end": 382.761,
     "text": "before your coffee is even cold."
    },
    {
     "start": 382.941,
     "end": 385.106,
     "text": "If something's tight, you know today."
    },
    {
     "start": 385.106,
     "end": 385.925,
     "text": "Not on Friday."
    }
   ]
  },
  {
   "id": "s37",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 386.205,
   "end": 396.381,
   "line_starts": [
    386.205,
    387.449,
    391.09,
    393.686
   ],
   "subs": [
    {
     "start": 386.205,
     "end": 387.269,
     "text": "Then you look ahead."
    },
    {
     "start": 387.449,
     "end": 389.151,
     "text": "Which bills are due this week?"
    },
    {
     "start": 389.151,
     "end": 390.91,
     "text": "Rent? Phone? The electric bill?"
    },
    {
     "start": 391.09,
     "end": 392.937,
     "text": "Is there enough money sitting there for"
    },
    {
     "start": 392.937,
     "end": 393.506,
     "text": "all of them?"
    },
    {
     "start": 393.686,
     "end": 395.028,
     "text": "He didn't lack the money."
    },
    {
     "start": 395.028,
     "end": 396.101,
     "text": "He just didn't look."
    }
   ]
  },
  {
   "id": "s38",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 396.381,
   "end": 404.413,
   "line_starts": [
    396.381,
    397.98,
    401.116
   ],
   "subs": [
    {
     "start": 396.381,
     "end": 397.8,
     "text": "Jake never does this."
    },
    {
     "start": 397.98,
     "end": 400.936,
     "text": "Last month, he completely forgot his electric bill."
    },
    {
     "start": 401.116,
     "end": 402.687,
     "text": "Late fee. Thirty dollars."
    },
    {
     "start": 402.687,
     "end": 404.133,
     "text": "For absolutely nothing."
    }
   ]
  },
  {
   "id": "s39",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 404.413,
   "end": 413.423,
   "line_starts": [
    404.413,
    407.08,
    410.511
   ],
   "subs": [
    {
     "start": 404.413,
     "end": 406.107,
     "text": "You? You haven't paid a late fee"
    },
    {
     "start": 406.107,
     "end": 406.9,
     "text": "in over a year."
    },
    {
     "start": 407.08,
     "end": 409.17,
     "text": "Because you see every bill coming..."
    },
    {
     "start": 409.17,
     "end": 410.331,
     "text": "days before it hits."
    },
    {
     "start": 410.511,
     "end": 413.143,
     "text": "No surprises. No panic. No fees."
    }
   ]
  },
  {
   "id": "s40",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 413.423,
   "end": 420.693,
   "line_starts": [
    413.423,
    415.559,
    417.25,
    418.806
   ],
   "subs": [
    {
     "start": 413.423,
     "end": 415.379,
     "text": "And then, the last part of your morning."
    },
    {
     "start": 415.559,
     "end": 417.07,
     "text": "You open a little notebook."
    },
    {
     "start": 417.25,
     "end": 418.626,
     "text": "And you pick your top three."
    },
    {
     "start": 418.806,
     "end": 420.413,
     "text": "Small list. Big days."
    }
   ]
  },
  {
   "id": "s41",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 420.693,
   "end": 435.012,
   "line_starts": [
    420.693,
    424.955,
    426.051,
    430.618
   ],
   "subs": [
    {
     "start": 420.693,
     "end": 422.925,
     "text": "Not a to-do list with twenty things"
    },
    {
     "start": 422.925,
     "end": 424.775,
     "text": "on it. Nobody finishes those."
    },
    {
     "start": 424.955,
     "end": 425.871,
     "text": "Just three."
    },
    {
     "start": 426.051,
     "end": 428.244,
     "text": "The three things that would make today"
    },
    {
     "start": 428.244,
     "end": 430.438,
     "text": "a win, even if nothing else gets done."
    },
    {
     "start": 430.618,
     "end": 433.36,
     "text": "Because willpower is strongest in the morning."
    },
    {
     "start": 433.36,
     "end": 434.732,
     "text": "Use it on what matters."
    }
   ]
  },
  {
   "id": "s42",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 435.012,
   "end": 442.82,
   "line_starts": [
    435.012,
    437.329,
    440.933
   ],
   "subs": [
    {
     "start": 435.012,
     "end": 436.199,
     "text": "And the hardest one?"
    },
    {
     "start": 436.199,
     "end": 437.149,
     "text": "You do it first."
    },
    {
     "start": 437.329,
     "end": 439.448,
     "text": "Before the emails. Before the meetings."
    },
    {
     "start": 439.448,
     "end": 440.753,
     "text": "Before the noise starts."
    },
    {
     "start": 440.933,
     "end": 442.54,
     "text": "While your brain is still fresh."
    }
   ]
  },
  {
   "id": "s43",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 442.82,
   "end": 455.77,
   "line_starts": [
    442.82,
    446.47,
    449.806,
    452.57
   ],
   "subs": [
    {
     "start": 442.82,
     "end": 443.554,
     "text": "By ten A M,"
    },
    {
     "start": 443.554,
     "end": 446.29,
     "text": "your most important work is already done."
    },
    {
     "start": 446.47,
     "end": 449.626,
     "text": "And Jake? He's still answering emails from yesterday."
    },
    {
     "start": 449.806,
     "end": 452.39,
     "text": "Still on his second coffee. Still behind."
    },
    {
     "start": 452.57,
     "end": 454.173,
     "text": "Not because you work longer."
    },
    {
     "start": 454.173,
     "end": 455.49,
     "text": "Because you work first."
    }
   ]
  },
  {
   "id": "s44",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 455.77,
   "end": 464.851,
   "line_starts": [
    455.77,
    458.304,
    461.681
   ],
   "subs": [
    {
     "start": 455.77,
     "end": 458.124,
     "text": "Your boss notices. Of course she does."
    },
    {
     "start": 458.304,
     "end": 459.406,
     "text": "You're the calm one."
    },
    {
     "start": 459.406,
     "end": 461.501,
     "text": "The one who actually gets things done."
    },
    {
     "start": 461.681,
     "end": 462.984,
     "text": "And people like that..."
    },
    {
     "start": 462.984,
     "end": 464.571,
     "text": "tend to get the raise first."
    }
   ]
  },
  {
   "id": "s45",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 464.851,
   "end": 475.388,
   "line_starts": [
    464.851,
    467.514,
    472.116
   ],
   "subs": [
    {
     "start": 464.851,
     "end": 466.123,
     "text": "So let's do the math."
    },
    {
     "start": 466.123,
     "end": 467.334,
     "text": "Just the money part."
    },
    {
     "start": 467.514,
     "end": 470.033,
     "text": "Jake spends about three thousand five hundred"
    },
    {
     "start": 470.033,
     "end": 471.936,
     "text": "dollars a year on rushed mornings."
    },
    {
     "start": 472.116,
     "end": 474.11,
     "text": "You spend about two hundred fifty on"
    },
    {
     "start": 474.11,
     "end": 475.108,
     "text": "breakfast at home."
    }
   ]
  },
  {
   "id": "s46",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 475.388,
   "end": 487.299,
   "line_starts": [
    475.388,
    476.435,
    479.838,
    484.974
   ],
   "subs": [
    {
     "start": 475.388,
     "end": 476.255,
     "text": "The difference?"
    },
    {
     "start": 476.435,
     "end": 479.658,
     "text": "Three thousand two hundred seventy six dollars. Every year."
    },
    {
     "start": 479.838,
     "end": 482.552,
     "text": "That's about two hundred seventy three dollars"
    },
    {
     "start": 482.552,
     "end": 484.794,
     "text": "a month, moved into savings on payday."
    },
    {
     "start": 484.974,
     "end": 487.019,
     "text": "Little things. Every single morning."
    }
   ]
  },
  {
   "id": "s47",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 487.299,
   "end": 495.854,
   "line_starts": [
    487.299,
    490.451,
    492.379
   ],
   "subs": [
    {
     "start": 487.299,
     "end": 489.514,
     "text": "And that's without counting the late fees"
