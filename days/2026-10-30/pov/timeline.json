   ],
   "subs": [
    {
     "start": 163.013,
     "end": 164.572,
     "text": "And then the scramble begins."
    },
    {
     "start": 164.872,
     "end": 166.787,
     "text": "No clean shirt. No breakfast."
    },
    {
     "start": 166.787,
     "end": 168.503,
     "text": "Keys? Where are the keys?!"
    },
    {
     "start": 168.803,
     "end": 171.179,
     "text": "He finds them in yesterday's jeans."
    },
    {
     "start": 171.179,
     "end": 172.061,
     "text": "On the floor."
    },
    {
     "start": 172.361,
     "end": 174.518,
     "text": "His heart is pounding before he even"
    },
    {
     "start": 174.518,
     "end": 175.777,
     "text": "leaves the apartment."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 176.227,
   "end": 184.059,
   "line_starts": [
    176.227,
    178.397,
    181.619
   ],
   "subs": [
    {
     "start": 176.227,
     "end": 178.097,
     "text": "He runs out the door with nothing."
    },
    {
     "start": 178.397,
     "end": 179.821,
     "text": "No coffee. No food."
    },
    {
     "start": 179.821,
     "end": 181.319,
     "text": "No plan for the day."
    },
    {
     "start": 181.619,
     "end": 183.609,
     "text": "Just stress. And a growing headache."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 184.059,
   "end": 194.625,
   "line_starts": [
    184.059,
    187.015,
    189.904,
    191.055
   ],
   "subs": [
    {
     "start": 184.059,
     "end": 186.715,
     "text": "And that's exactly where his wallet starts bleeding."
    },
    {
     "start": 187.015,
     "end": 189.604,
     "text": "Quietly. Politely. Every single morning."
    },
    {
     "start": 189.904,
     "end": 190.755,
     "text": "Watch this."
    },
    {
     "start": 191.055,
     "end": 192.133,
     "text": "And the worst part?"
    },
    {
     "start": 192.133,
     "end": 194.175,
     "text": "He doesn't even notice it happening."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 194.625,
   "end": 203.534,
   "line_starts": [
    194.625,
    197.828,
    200.906
   ],
   "subs": [
    {
     "start": 194.625,
     "end": 197.528,
     "text": "Stop number one: the coffee shop on the corner."
    },
    {
     "start": 197.828,
     "end": 199.398,
     "text": "There's a line, of course."
    },
    {
     "start": 199.398,
     "end": 200.606,
     "text": "He's even later now."
    },
    {
     "start": 200.906,
     "end": 203.084,
     "text": "A large latte. Six dollars."
    }
   ]
  },
  {
   "id": "s18",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 203.534,
   "end": 211.179,
   "line_starts": [
    203.534,
    207.535,
