    218.667
   ],
   "subs": [
    {
     "start": 211.179,
     "end": 213.977,
     "text": "Fourteen dollars. Gone before nine A M."
    },
    {
     "start": 214.277,
     "end": 215.801,
     "text": "Does that sound like a lot?"
    },
    {
     "start": 216.101,
     "end": 218.367,
     "text": "Not really, right? It's just breakfast."
    },
    {
     "start": 218.667,
     "end": 221.21,
     "text": "And honestly, Jake would say the same thing."
    }
   ]
  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 221.66,
   "end": 231.539,
   "line_starts": [
    221.66,
    225.359,
    227.575
   ],
   "subs": [
    {
     "start": 221.66,
     "end": 223.045,
     "text": "But let's do the math."
    },
    {
     "start": 223.045,
     "end": 225.059,
     "text": "Fourteen dollars, every workday."
    },
    {
     "start": 225.359,
     "end": 227.275,
     "text": "About twenty one workdays a month."
    },
    {
     "start": 227.575,
     "end": 231.089,
     "text": "That's roughly two hundred ninety four dollars. Every month."
    }
   ]
  },
  {
   "id": "s21",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 231.539,
   "end": 244.833,
   "line_starts": [
    231.539,
    235.54,
    239.552,
