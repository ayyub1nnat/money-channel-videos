   ],
   "subs": [
    {
     "start": 154.469,
     "end": 157.364,
     "text": "Those extra minutes don't give you real, deep rest."
    },
    {
     "start": 157.664,
     "end": 159.093,
     "text": "You just drift in and out,"
    },
    {
     "start": 159.093,
     "end": 159.808,
     "text": "in and out..."
    },
    {
     "start": 160.108,
     "end": 162.563,
     "text": "and you wake up even groggier than before."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 163.013,
   "end": 176.227,
   "line_starts": [
    163.013,
    164.872,
    168.803,
