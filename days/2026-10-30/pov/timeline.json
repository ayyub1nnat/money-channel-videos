   ],
   "subs": [
    {
     "start": 244.833,
     "end": 246.099,
     "text": "And you know what's worse?"
    },
    {
     "start": 246.399,
     "end": 248.259,
     "text": "Jake isn't even enjoying it."
    },
    {
     "start": 248.559,
     "end": 250.021,
     "text": "He's eating at his desk,"
    },
    {
     "start": 250.021,
     "end": 252.397,
     "text": "stressed, already behind on everything."
    },
    {
     "start": 252.697,
     "end": 254.25,
     "text": "By lunch, he's exhausted."
    },
    {
     "start": 254.25,
     "end": 255.865,
     "text": "And he's buying lunch too."
    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 256.315,
   "end": 265.724,
   "line_starts": [
    256.315,
    258.16,
    261.815
   ],
   "subs": [
    {
     "start": 256.315,
     "end": 257.86,
     "text": "Now. Let's look at your morning."
    },
    {
     "start": 258.16,
     "end": 259.757,
     "text": "Same city. Same job."
    },
    {
     "start": 259.757,
     "end": 261.515,
     "text": "Same paycheck as Jake."
    },
    {
     "start": 261.815,
     "end": 263.901,
     "text": "The only difference is what happens in"
    },
    {
     "start": 263.901,
     "end": 265.274,
     "text": "the first thirty minutes."
    }
   ]
  },
  {
   "id": "s24",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 265.724,
   "end": 279.923,
   "line_starts": [
    265.724,
    269.074,
    270.856,
    275.361
   ],
   "subs": [
    {
     "start": 265.724,
     "end": 267.249,
     "text": "You get up at six thirty."
    },
    {
     "start": 267.249,
     "end": 268.774,
     "text": "You walk across the room."
    },
    {
     "start": 269.074,
     "end": 270.556,
     "text": "You switch off the alarm."
    },
    {
     "start": 270.856,
     "end": 272.748,
     "text": "And then you do something that feels"
    },
    {
     "start": 272.748,
     "end": 275.061,
     "text": "weird at first... you leave the phone there."
    },
    {
     "start": 275.361,
     "end": 277.598,
     "text": "No notifications. No headlines."
    },
    {
     "start": 277.598,
     "end": 279.473,
     "text": "Just you and a quiet room."
    }
   ]
  },
  {
   "id": "s25",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 279.923,
   "end": 291.829,
   "line_starts": [
    279.923,
    284.5,
    288.203
   ],
   "subs": [
    {
     "start": 279.923,
     "end": 282.24,
     "text": "Because the second you open your phone,"
    },
    {
     "start": 282.24,
     "end": 284.2,
     "text": "your morning isn't yours anymore."
    },
    {
     "start": 284.5,
     "end": 286.269,
     "text": "Emails. News. Group chats."
    },
    {
     "start": 286.269,
     "end": 287.903,
     "text": "Other people's problems."
    },
    {
     "start": 288.203,
     "end": 289.989,
     "text": "You haven't even brushed your teeth,"
    },
    {
     "start": 289.989,
     "end": 291.379,
     "text": "and you're already stressed."
    }
   ]
  },
  {
   "id": "s26",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 291.829,
   "end": 303.617,
   "line_starts": [
    291.829,
    294.877,
    297.745,
    300.339
   ],
   "subs": [
    {
     "start": 291.829,
     "end": 294.577,
     "text": "So instead, you drink a big glass of water."
    },
    {
     "start": 294.877,
     "end": 296.161,
     "text": "You open the window."
    },
    {
     "start": 296.161,
     "end": 297.445,
     "text": "Cold air. Fresh air."
    },
    {
     "start": 297.745,
     "end": 300.039,
     "text": "Five slow, deep breaths. That's it."
    },
    {
     "start": 300.339,
     "end": 301.682,
     "text": "Your body wakes up."
    },
    {
     "start": 301.682,
     "end": 303.167,
     "text": "Your mind slows down."
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 303.617,
   "end": 313.372,
   "line_starts": [
    303.617,
    305.761,
    310.044
   ],
   "subs": [
    {
     "start": 303.617,
     "end": 305.461,
     "text": "Then you move. Just ten minutes."
    },
    {
     "start": 305.761,
     "end": 307.231,
     "text": "A walk around the block."
    },
    {
     "start": 307.231,
     "end": 309.744,
     "text": "A few stretches on the living room floor."
    },
    {
     "start": 310.044,
     "end": 311.803,
     "text": "Nothing fancy. No gym."
    },
    {
     "start": 311.803,
     "end": 312.922,
     "text": "No fancy gear."
    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 313.372,
   "end": 327.276,
   "line_starts": [
    313.372,
    315.754,
    319.204,
    322.334
   ],
   "subs": [
    {
     "start": 313.372,
     "end": 315.454,
     "text": "You're not training for a marathon here."
    },
    {
     "start": 315.754,
     "end": 317.62,
     "text": "You're just telling your body..."
    },
    {
     "start": 317.62,
     "end": 318.904,
     "text": "hey. It's daytime now."
    },
    {
     "start": 319.204,
     "end": 320.813,
     "text": "And by the time you get back,"
    },
    {
     "start": 320.813,
     "end": 322.034,
     "text": "your head feels clear."
    },
    {
     "start": 322.334,
     "end": 324.837,
     "text": "Some mornings you even see the sunrise."
    },
    {
     "start": 324.837,
     "end": 326.826,
     "text": "Jake hasn't seen one in months."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 327.276,
   "end": 336.595,
   "line_starts": [
    327.276,
    330.224,
    332.956
   ],
   "subs": [
    {
     "start": 327.276,
     "end": 329.924,
     "text": "Back home, the coffee's already ready and waiting."
    },
    {
     "start": 330.224,
     "end": 332.656,
     "text": "Because you set it up last night. Remember?"
    },
    {
     "start": 332.956,
     "end": 335.457,
     "text": "That smell. Honestly, it's the best part"
    },
    {
     "start": 335.457,
     "end": 336.145,
     "text": "of the day."
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 336.595,
   "end": 349.646,
   "line_starts": [
    336.595,
    339.791,
    343.357,
    345.93
   ],
   "subs": [
    {
     "start": 336.595,
     "end": 338.767,
     "text": "Coffee at home costs you about fifty"
    },
    {
     "start": 338.767,
     "end": 339.491,
     "text": "cents a cup."
    },
    {
     "start": 339.791,
     "end": 341.288,
     "text": "Oatmeal with a banana?"
    },
    {
     "start": 341.288,
     "end": 343.057,
     "text": "Maybe another fifty cents."
    },
    {
     "start": 343.357,
     "end": 345.63,
     "text": "So breakfast costs you about one dollar."
    },
    {
     "start": 345.93,
     "end": 346.926,
     "text": "And you know what?"
    },
    {
     "start": 346.926,
     "end": 349.196,
     "text": "It tastes better than the six dollar one."
    }
   ]
  },
  {
   "id": "s31",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 349.646,
   "end": 360.91,
   "line_starts": [
    349.646,
    353.379,
    356.885
   ],
   "subs": [
    {
     "start": 349.646,
     "end": 351.297,
     "text": "One dollar. Sitting down."
    },
    {
     "start": 351.297,
     "end": 353.079,
     "text": "Actually tasting your food."
    },
    {
     "start": 353.379,
     "end": 356.585,
     "text": "Versus Jake's fourteen dollar sprint down the sidewalk."
    },
    {
     "start": 356.885,
     "end": 359.07,
     "text": "Same caffeine. Same full stomach."
    },
    {
     "start": 359.07,
     "end": 360.46,
     "text": "Very different price."
    }
   ]
  },
  {
   "id": "s32",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 360.91,
   "end": 368.989,
   "line_starts": [
    360.91,
    363.84,
    367.022
   ],
   "subs": [
    {
     "start": 360.91,
     "end": 363.54,
     "text": "And now comes the part that changes everything."
    },
    {
     "start": 363.84,
     "end": 365.128,
     "text": "It takes ten minutes."
    },
    {
     "start": 365.128,
     "end": 366.722,
     "text": "And almost nobody does it."
    },
    {
     "start": 367.022,
     "end": 368.539,
     "text": "The ten minute money check."
    }
   ]
  },
  {
   "id": "s33",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 368.989,
   "end": 381.192,
   "line_starts": [
    368.989,
    372.062,
    374.285,
    377.54
   ],
   "subs": [
    {
     "start": 368.989,
     "end": 370.628,
     "text": "Now you pick up the phone."
    },
    {
     "start": 370.628,
     "end": 371.762,
     "text": "But only for this."
    },
    {
     "start": 372.062,
     "end": 373.985,
     "text": "Minute one: you look at your balance."
    },
    {
     "start": 374.285,
     "end": 375.763,
     "text": "No fear. No guessing."
    },
    {
     "start": 375.763,
     "end": 377.24,
     "text": "Just the real number."
    },
    {
     "start": 377.54,
     "end": 379.345,
     "text": "Ten minutes. One cup of coffee."
    },
    {
     "start": 379.345,
     "end": 380.742,
     "text": "That's the whole system."
    }
   ]
  },
  {
   "id": "s34",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 381.192,
   "end": 390.466,
   "line_starts": [
    381.192,
    384.521,
    387.748
   ],
   "subs": [
    {
     "start": 381.192,
     "end": 382.954,
     "text": "Next: you check what came out of"
    },
    {
     "start": 382.954,
     "end": 384.221,
     "text": "your account yesterday."
    },
    {
     "start": 384.521,
     "end": 387.448,
     "text": "Anything weird? A charge you don't recognize?"
    },
    {
     "start": 387.748,
     "end": 390.016,
     "text": "Most days, it's nothing. But today..."
    }
   ]
  },
  {
   "id": "s35",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 390.466,
   "end": 404.48,
   "line_starts": [
    390.466,
    392.172,
    397.323,
    400.248
   ],
   "subs": [
    {
     "start": 390.466,
     "end": 391.872,
     "text": "Today, you catch something."
    },
    {
     "start": 392.172,
     "end": 394.139,
     "text": "A free trial you forgot about."
    },
    {
     "start": 394.139,
     "end": 397.023,
     "text": "It just turned into a fifteen dollar charge."
    },
    {
     "start": 397.323,
     "end": 399.948,
     "text": "And it would've kept charging you. Every month."
    },
    {
     "start": 400.248,
     "end": 402.643,
     "text": "Fifteen dollars a month is one hundred"
    },
    {
     "start": 402.643,
     "end": 404.03,
     "text": "eighty dollars a year."
    }
   ]
  },
  {
   "id": "s36",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 404.48,
   "end": 415.219,
   "line_starts": [
    404.48,
    407.248,
    409.376,
    411.612
   ],
   "subs": [
    {
     "start": 404.48,
     "end": 406.948,
     "text": "You cancel it. Right there. Thirty seconds."
    },
    {
     "start": 407.248,
     "end": 409.076,
     "text": "Fifteen dollars a month, saved..."
    },
    {
     "start": 409.376,
     "end": 411.312,
     "text": "before your coffee is even cold."
    },
    {
     "start": 411.612,
     "end": 413.902,
     "text": "If something's tight, you know today."
    },
    {
     "start": 413.902,
     "end": 414.769,
     "text": "Not on Friday."
    }
   ]
  },
  {
   "id": "s37",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 415.219,
   "end": 426.204,
   "line_starts": [
    415.219,
    416.609,
    420.499,
    423.302
   ],
   "subs": [
    {
     "start": 415.219,
     "end": 416.309,
     "text": "Then you look ahead."
    },
    {
     "start": 416.609,
     "end": 418.375,
     "text": "Which bills are due this week?"
    },
    {
     "start": 418.375,
     "end": 420.199,
     "text": "Rent? Phone? The electric bill?"
    },
    {
     "start": 420.499,
     "end": 422.413,
     "text": "Is there enough money sitting there for"
    },
    {
     "start": 422.413,
     "end": 423.002,
     "text": "all of them?"
    },
    {
     "start": 423.302,
     "end": 424.664,
     "text": "He didn't lack the money."
    },
    {
     "start": 424.664,
     "end": 425.754,
     "text": "He just didn't look."
    }
   ]
  },
  {
   "id": "s38",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 426.204,
   "end": 434.923,
   "line_starts": [
    426.204,
    428.016,
    431.39
   ],
   "subs": [
    {
     "start": 426.204,
     "end": 427.716,
     "text": "Jake never does this."
    },
    {
     "start": 428.016,
     "end": 431.09,
     "text": "Last month, he completely forgot his electric bill."
    },
    {
     "start": 431.39,
     "end": 432.996,
     "text": "Late fee. Thirty dollars."
    },
    {
     "start": 432.996,
     "end": 434.473,
     "text": "For absolutely nothing."
    }
   ]
  },
  {
   "id": "s39",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 434.923,
   "end": 444.702,
   "line_starts": [
    434.923,
    437.867,
    441.522
   ],
   "subs": [
    {
     "start": 434.923,
     "end": 436.723,
     "text": "You? You haven't paid a late fee"
    },
    {
     "start": 436.723,
     "end": 437.567,
     "text": "in over a year."
    },
    {
     "start": 437.867,
     "end": 440.024,
     "text": "Because you see every bill coming..."
    },
    {
     "start": 440.024,
     "end": 441.222,
     "text": "days before it hits."
    },
    {
     "start": 441.522,
     "end": 444.252,
     "text": "No surprises. No panic. No fees."
    }
   ]
  },
  {
   "id": "s40",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 444.702,
   "end": 452.664,
   "line_starts": [
    444.702,
    447.008,
    448.838,
    450.59
   ],
   "subs": [
    {
     "start": 444.702,
     "end": 446.708,
     "text": "And then, the last part of your morning."
    },
    {
     "start": 447.008,
     "end": 448.538,
     "text": "You open a little notebook."
    },
    {
     "start": 448.838,
     "end": 450.29,
     "text": "And you pick your top three."
    },
    {
     "start": 450.59,
     "end": 452.214,
     "text": "Small list. Big days."
    }
   ]
  },
  {
   "id": "s41",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 452.664,
   "end": 467.902,
   "line_starts": [
    452.664,
    457.223,
    458.439,
    463.208
   ],
   "subs": [
    {
     "start": 452.664,
     "end": 454.993,
     "text": "Not a to-do list with twenty things"
    },
    {
     "start": 454.993,
     "end": 456.923,
     "text": "on it. Nobody finishes those."
    },
    {
     "start": 457.223,
     "end": 458.139,
     "text": "Just three."
    },
    {
     "start": 458.439,
     "end": 460.674,
     "text": "The three things that would make today"
    },
    {
     "start": 460.674,
     "end": 462.908,
     "text": "a win, even if nothing else gets done."
    },
    {
     "start": 463.208,
     "end": 466.038,
     "text": "Because willpower is strongest in the morning."
    },
    {
     "start": 466.038,
     "end": 467.452,
     "text": "Use it on what matters."
    }
   ]
  },
  {
   "id": "s42",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 467.902,
   "end": 476.269,
   "line_starts": [
    467.902,
    470.366,
    474.154
   ],
   "subs": [
    {
     "start": 467.902,
     "end": 469.105,
     "text": "And the hardest one?"
    },
    {
     "start": 469.105,
     "end": 470.066,
     "text": "You do it first."
    },
    {
     "start": 470.366,
     "end": 472.525,
     "text": "Before the emails. Before the meetings."
    },
    {
     "start": 472.525,
     "end": 473.854,
     "text": "Before the noise starts."
    },
    {
     "start": 474.154,
     "end": 475.819,
     "text": "While your brain is still fresh."
    }
   ]
  },
  {
   "id": "s43",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 476.269,
   "end": 490.091,
   "line_starts": [
    476.269,
    480.145,
    483.676,
    486.625
   ],
   "subs": [
    {
     "start": 476.269,
     "end": 477.025,
     "text": "By ten A M,"
    },
    {
     "start": 477.025,
     "end": 479.845,
     "text": "your most important work is already done."
    },
    {
     "start": 480.145,
     "end": 483.376,
     "text": "And Jake? He's still answering emails from yesterday."
    },
    {
     "start": 483.676,
     "end": 486.325,
     "text": "Still on his second coffee. Still behind."
    },
    {
     "start": 486.625,
     "end": 488.28,
     "text": "Not because you work longer."
    },
    {
     "start": 488.28,
     "end": 489.641,
     "text": "Because you work first."
    }
   ]
  },
  {
   "id": "s44",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 490.091,
   "end": 499.869,
   "line_starts": [
    490.091,
    492.808,
    496.441
   ],
   "subs": [
    {
     "start": 490.091,
     "end": 492.508,
     "text": "Your boss notices. Of course she does."
    },
    {
     "start": 492.808,
     "end": 493.957,
     "text": "You're the calm one."
    },
    {
     "start": 493.957,
     "end": 496.141,
     "text": "The one who actually gets things done."
    },
    {
     "start": 496.441,
     "end": 497.784,
     "text": "And people like that..."
    },
    {
     "start": 497.784,
     "end": 499.419,
     "text": "tend to get the raise first."
    }
   ]
  },
  {
   "id": "s45",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 499.869,
   "end": 511.048,
   "line_starts": [
    499.869,
    502.688,
    507.51
   ],
   "subs": [
    {
     "start": 499.869,
     "end": 501.159,
     "text": "So let's do the math."
    },
    {
     "start": 501.159,
     "end": 502.388,
     "text": "Just the money part."
    },
    {
     "start": 502.688,
     "end": 505.264,
     "text": "Jake spends about three thousand five hundred"
    },
    {
     "start": 505.264,
     "end": 507.21,
     "text": "dollars a year on rushed mornings."
    },
    {
     "start": 507.51,
     "end": 509.569,
     "text": "You spend about two hundred fifty on"
    },
    {
     "start": 509.569,
     "end": 510.598,
     "text": "breakfast at home."
    }
   ]
  },
  {
   "id": "s46",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 511.048,
   "end": 523.782,
   "line_starts": [
    511.048,
    512.229,
    515.91,
    521.251
   ],
   "subs": [
    {
     "start": 511.048,
     "end": 511.929,
     "text": "The difference?"
    },
    {
     "start": 512.229,
     "end": 515.61,
     "text": "Three thousand two hundred seventy six dollars. Every year."
    },
    {
     "start": 515.91,
     "end": 518.67,
     "text": "That's about two hundred seventy three dollars"
    },
    {
     "start": 518.67,
     "end": 520.951,
     "text": "a month, moved into savings on payday."
    },
    {
     "start": 521.251,
     "end": 523.332,
     "text": "Little things. Every single morning."
    }
   ]
  },
  {
   "id": "s47",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 523.782,
   "end": 532.945,
   "line_starts": [
    523.782,
    527.063,
    529.136
   ],
   "subs": [
    {
     "start": 523.782,
     "end": 526.004,
     "text": "And that's without counting the late fees"
    },
    {
