   ],
   "subs": [
    {
     "start": 100.67,
     "end": 102.404,
     "text": "And then you do one more thing."
    },
    {
     "start": 102.404,
     "end": 103.075,
     "text": "The big one."
    },
    {
     "start": 103.375,
     "end": 104.841,
     "text": "You plug your phone in..."
    },
    {
     "start": 104.841,
     "end": 105.779,
     "text": "across the room."
    },
    {
     "start": 106.079,
     "end": 107.206,
     "text": "Not on your pillow."
    },
    {
     "start": 107.206,
     "end": 108.214,
     "text": "Not in your hand."
    },
    {
     "start": 108.214,
     "end": 109.163,
     "text": "Across the room."
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 109.613,
   "end": 119.96,
   "line_starts": [
    109.613,
    114.499,
    116.056
   ],
   "subs": [
    {
     "start": 109.613,
     "end": 111.998,
     "text": "Why? Because now, when the alarm rings,"
    },
    {
     "start": 111.998,
     "end": 114.199,
     "text": "you have to stand up to turn it off."
    },
    {
     "start": 114.499,
     "end": 115.756,
     "text": "And once you're standing?"
    },
    {
     "start": 116.056,
     "end": 118.573,
     "text": "Honestly... the hardest part of the morning"
    },
    {
     "start": 118.573,
     "end": 119.51,
     "text": "is already over."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 119.96,
   "end": 132.004,
   "line_starts": [
    119.96,
    122.461,
    125.415,
    127.761
   ],
   "subs": [
    {
     "start": 119.96,
     "end": 122.161,
     "text": "Meanwhile, Jake is in bed. Scrolling."
    },
    {
     "start": 122.461,
     "end": 125.115,
     "text": "Eleven thirty. Midnight. Twelve forty."
    },
    {
     "start": 125.415,
     "end": 127.461,
     "text": "One more video. Just one more."
    },
    {
     "start": 127.761,
     "end": 129.447,
     "text": "His brain is wide awake."
    },
    {
     "start": 129.447,
     "end": 131.554,
     "text": "His body is begging for sleep."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 132.004,
   "end": 144.845,
   "line_starts": [
    132.004,
    135.226,
    138.39,
    141.959
   ],
   "subs": [
    {
     "start": 132.004,
     "end": 134.006,
     "text": "Most adults need at least seven hours"
    },
    {
     "start": 134.006,
     "end": 134.926,
     "text": "of sleep a night."
    },
    {
     "start": 135.226,
     "end": 136.445,
     "text": "Jake gets about six."
    },
    {
     "start": 136.445,
     "end": 138.09,
     "text": "And that's on a good night."
    },
    {
     "start": 138.39,
     "end": 140.411,
     "text": "He doesn't feel tired at midnight."
    },
    {
     "start": 140.411,
     "end": 141.659,
     "text": "He feels it at seven."
    },
    {
     "start": 141.959,
     "end": 144.395,
     "text": "So every morning starts with a little sleep debt."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 144.845,
   "end": 154.469,
   "line_starts": [
    144.845,
    148.998,
    151.821
   ],
   "subs": [
    {
     "start": 144.845,
     "end": 146.088,
     "text": "So the next morning,"
    },
    {
     "start": 146.088,
     "end": 148.698,
     "text": "that snooze button feels like a lifesaver."
    },
    {
     "start": 148.998,
     "end": 150.348,
     "text": "Just nine more minutes."
    },
    {
     "start": 150.348,
     "end": 151.521,
     "text": "What could go wrong?"
    },
    {
     "start": 151.821,
     "end": 153.306,
     "text": "But it isn't a lifesaver."
    },
    {
     "start": 153.306,
     "end": 154.019,
     "text": "It's a trap."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 154.469,
   "end": 163.013,
   "line_starts": [
    154.469,
