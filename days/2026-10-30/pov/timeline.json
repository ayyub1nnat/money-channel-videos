   ],
   "subs": [
    {
     "start": 0.3,
     "end": 2.244,
     "text": "It's six thirty in the morning."
    },
    {
     "start": 2.244,
     "end": 4.0,
     "text": "Your alarm goes off... once."
    },
    {
     "start": 4.3,
     "end": 5.607,
     "text": "And you actually get up."
    },
    {
     "start": 5.907,
     "end": 7.429,
     "text": "No snooze. No panic."
    },
    {
     "start": 7.429,
     "end": 9.56,
     "text": "No racing heart. Just... up."
    },
    {
     "start": 9.86,
     "end": 11.897,
     "text": "You even have time to make the bed."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 12.347,
   "end": 26.53,
   "line_starts": [
    12.347,
    16.689,
    19.153,
    22.521
   ],
   "subs": [
    {
     "start": 12.347,
     "end": 14.971,
     "text": "Across town, Jake's alarm goes off at"
    },
    {
     "start": 14.971,
     "end": 16.389,
     "text": "the exact same time."
    },
    {
     "start": 16.689,
     "end": 18.853,
     "text": "He hits snooze. Then again. And again."
    },
    {
     "start": 19.153,
     "end": 21.399,
     "text": "Every nine minutes, the same little fight"
    },
    {
     "start": 21.399,
     "end": 22.221,
     "text": "with his phone."
    },
    {
     "start": 22.521,
     "end": 24.668,
     "text": "And every time, he tells himself..."
    },
    {
     "start": 24.668,
     "end": 26.08,
     "text": "just five more minutes."
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 26.53,
   "end": 35.359,
   "line_starts": [
    26.53,
    30.381,
    32.278
   ],
   "subs": [
    {
     "start": 26.53,
     "end": 28.369,
     "text": "By the time he opens his eyes"
    },
    {
     "start": 28.369,
     "end": 30.081,
     "text": "for real, it's eight fifty."
    },
    {
     "start": 30.381,
     "end": 31.978,
     "text": "His meeting starts at nine."
    },
    {
     "start": 32.278,
     "end": 34.909,
     "text": "He's late. Again. Third time this month."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 35.359,
   "end": 49.012,
   "line_starts": [
    35.359,
    37.759,
    40.438,
    44.139
   ],
   "subs": [
    {
     "start": 35.359,
     "end": 37.459,
     "text": "And here's the thing nobody tells you."
    },
    {
     "start": 37.759,
     "end": 40.138,
     "text": "Jake's messy morning isn't just stressful."
    },
    {
     "start": 40.438,
     "end": 41.943,
     "text": "It's costing him money."
    },
    {
     "start": 41.943,
     "end": 43.84,
     "text": "Real money. Every single day."
    },
    {
     "start": 44.139,
     "end": 46.509,
     "text": "Not in one big painful moment."
    },
    {
     "start": 46.509,
     "end": 48.562,
     "text": "In tiny, invisible pieces."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 49.012,
   "end": 61.889,
   "line_starts": [
    49.012,
    53.659,
    57.995
   ],
   "subs": [
    {
     "start": 49.012,
     "end": 50.892,
     "text": "Stay with me, because by the end"
    },
    {
     "start": 50.892,
     "end": 53.359,
     "text": "of this story you'll see exactly how much."
    },
    {
     "start": 53.659,
     "end": 55.99,
     "text": "And the simple morning routine that makes"
    },
    {
     "start": 55.99,
     "end": 57.695,
     "text": "you calmer, more productive..."
    },
    {
     "start": 57.995,
     "end": 61.439,
     "text": "and about three thousand dollars richer every single year."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 61.889,
   "end": 76.335,
   "line_starts": [
    61.889,
    65.433,
    68.947,
    71.973
   ],
   "subs": [
    {
     "start": 61.889,
     "end": 64.03,
     "text": "So let's rewind. Let's go back to"
    },
    {
     "start": 64.03,
     "end": 65.133,
     "text": "the night before."
    },
    {
     "start": 65.433,
     "end": 67.844,
     "text": "Because a good morning doesn't actually start"
    },
    {
     "start": 67.844,
     "end": 68.647,
     "text": "in the morning."
    },
    {
     "start": 68.947,
     "end": 71.673,
     "text": "It starts around nine thirty the evening before."
    },
    {
     "start": 71.973,
     "end": 73.832,
     "text": "Sounds boring? Stick with me."
    },
    {
     "start": 73.832,
     "end": 75.885,
     "text": "This is where the magic happens."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 76.335,
   "end": 85.459,
   "line_starts": [
    76.335,
    78.569,
    81.255
   ],
   "subs": [
    {
     "start": 76.335,
     "end": 78.269,
     "text": "You give it ten minutes. That's all."
    },
    {
     "start": 78.569,
     "end": 80.956,
     "text": "You lay out tomorrow's clothes on the chair."
    },
    {
     "start": 81.255,
     "end": 82.429,
     "text": "You pack your lunch."
    },
    {
     "start": 82.429,
     "end": 85.009,
     "text": "You fill the coffee maker and set the timer."
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 85.459,
   "end": 100.67,
   "line_starts": [
    85.459,
    89.416,
    91.616,
    96.34
   ],
   "subs": [
    {
     "start": 85.459,
     "end": 88.025,
     "text": "Keys, wallet, badge... all in one little"
    },
    {
     "start": 88.025,
     "end": 89.116,
     "text": "bowl by the door."
    },
    {
     "start": 89.416,
     "end": 91.316,
     "text": "It feels almost too simple, right?"
    },
    {
     "start": 91.616,
     "end": 93.8,
     "text": "But every decision you make tonight is"
    },
    {
     "start": 93.8,
     "end": 96.04,
     "text": "one you don't have to make half asleep."
    },
    {
     "start": 96.34,
     "end": 97.842,
     "text": "No searching. No stress."
    },
    {
     "start": 97.842,
     "end": 100.22,
     "text": "Everything is right where you left it."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 100.67,
   "end": 109.613,
