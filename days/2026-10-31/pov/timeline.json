{
 "title": "POV: Mia Spends $410 on Halloween\u2026 You Spend $42 and Nobody Can Tell the Difference",
 "duration": 589.264,
 "scenes": [
  {
   "id": "s0",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 0.2,
   "end": 16.252,
   "line_starts": [
    0.2,
    4.509,
    9.384,
    12.807
   ],
   "subs": [
    {
     "start": 0.2,
     "end": 3.019,
     "text": "It's Halloween night. Your doorbell rings for"
    },
    {
     "start": 3.019,
     "end": 4.209,
     "text": "the twentieth time."
    },
    {
     "start": 4.509,
     "end": 5.702,
     "text": "You open the door,"
    },
    {
     "start": 5.702,
     "end": 9.084,
     "text": "smile, and drop candy into a little pumpkin bucket."
    },
    {
     "start": 9.384,
     "end": 11.582,
     "text": "You're wearing a costume you made from"
    },
    {
     "start": 11.582,
     "end": 12.507,
     "text": "your own closet."
    },
    {
     "start": 12.807,
     "end": 15.752,
     "text": "And this whole night cost you... forty-two dollars."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 16.252,
   "end": 33.129,
   "line_starts": [
    16.252,
    20.256,
    24.215,
    30.21
   ],
   "subs": [
    {
     "start": 16.252,
     "end": 18.787,
     "text": "Across town, your friend Mia is getting"
    },
    {
     "start": 18.787,
     "end": 19.956,
     "text": "ready for a party."
    },
    {
     "start": 20.256,
     "end": 22.696,
     "text": "Her costume? One hundred eighty dollars."
    },
    {
     "start": 22.696,
     "end": 23.915,
     "text": "She'll wear it once."
    },
    {
     "start": 24.215,
     "end": 26.577,
     "text": "Plus a second outfit for Saturday."
    },
    {
     "start": 26.577,
     "end": 29.91,
     "text": "Plus new decorations. Plus a pumpkin patch trip."
    },
    {
     "start": 30.21,
     "end": 32.629,
     "text": "And she's excited. Really excited."
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 33.129,
   "end": 46.201,
   "line_starts": [
    33.129,
    36.744,
    40.197,
    43.946
   ],
   "subs": [
    {
     "start": 33.129,
     "end": 34.817,
     "text": "When she adds it all up next"
    },
    {
     "start": 34.817,
     "end": 36.444,
     "text": "week, the number will hurt."
    },
    {
     "start": 36.744,
     "end": 38.822,
     "text": "Four hundred and ten dollars."
    },
    {
     "start": 38.822,
     "end": 39.897,
     "text": "On one holiday."
    },
    {
     "start": 40.197,
     "end": 41.105,
     "text": "And most of it?"
    },
    {
     "start": 41.105,
     "end": 43.646,
     "text": "It's sitting on her credit card right now."
    },
    {
     "start": 43.946,
     "end": 45.701,
     "text": "Let that sink in for a second."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 46.201,
   "end": 60.44,
   "line_starts": [
    46.201,
    47.904,
    54.811,
    57.715
   ],
   "subs": [
    {
     "start": 46.201,
     "end": 47.604,
     "text": "Here's the crazy part."
    },
    {
     "start": 47.904,
     "end": 50.149,
     "text": "At the party, nobody can tell which"
    },
    {
     "start": 50.149,
     "end": 52.843,
     "text": "costume cost one hundred eighty dollars..."
    },
    {
     "start": 52.843,
     "end": 54.511,
     "text": "and which one cost twelve."
    },
    {
     "start": 54.811,
     "end": 57.415,
     "text": "Everyone just has fun. Including you."
    },
    {
     "start": 57.715,
     "end": 59.94,
     "text": "Nobody checks the price tag on your hat."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 60.44,
   "end": 76.331,
   "line_starts": [
    60.44,
    62.461,
    71.114,
    74.36
   ],
   "subs": [
    {
     "start": 60.44,
     "end": 62.161,
     "text": "And Mia isn't unusual."
    },
    {
     "start": 62.461,
     "end": 65.936,
     "text": "The National Retail Federation expected Americans to"
    },
    {
     "start": 65.936,
     "end": 68.208,
     "text": "spend a record thirteen and a half"
    },
    {
     "start": 68.208,
     "end": 70.814,
     "text": "billion dollars on Halloween this year."
    },
    {
     "start": 71.114,
     "end": 74.06,
     "text": "That's about one hundred fifteen dollars per person."
    },
    {
     "start": 74.36,
     "end": 75.831,
     "text": "A new record. Again."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 76.331,
   "end": 89.572,
   "line_starts": [
    76.331,
    78.722,
    80.865,
    85.289
   ],
   "subs": [
    {
     "start": 76.331,
     "end": 78.422,
     "text": "And here's how it usually happens."
    },
    {
     "start": 78.722,
     "end": 80.565,
     "text": "It's never one big purchase."
    },
    {
     "start": 80.865,
     "end": 82.794,
     "text": "A ten-dollar decoration here."
    },
    {
     "start": 82.794,
     "end": 84.989,
     "text": "A fifteen-dollar candy run there."
    },
    {
     "start": 85.289,
     "end": 87.748,
     "text": "Little 'it's just Halloween' moments..."
    },
    {
     "start": 87.748,
     "end": 89.072,
     "text": "and they add up fast."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 89.572,
   "end": 105.259,
   "line_starts": [
    89.572,
    91.016,
    96.308,
    101.359
   ],
   "subs": [
    {
     "start": 89.572,
     "end": 90.716,
     "text": "So stay with me."
    },
    {
     "start": 91.016,
     "end": 93.325,
     "text": "I'll show you exactly how you enjoyed"
    },
    {
     "start": 93.325,
     "end": 96.008,
     "text": "the same Halloween for forty-two dollars..."
    },
    {
     "start": 96.308,
     "end": 98.501,
     "text": "and the one thing you'll do tomorrow"
    },
    {
     "start": 98.501,
     "end": 101.059,
     "text": "morning that makes next year even cheaper."
    },
    {
     "start": 101.359,
     "end": 103.324,
     "text": "No guilt. No boring rules."
    },
    {
     "start": 103.324,
     "end": 104.759,
     "text": "Just smarter moves."
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 105.259,
   "end": 118.594,
   "line_starts": [
    105.259,
    108.459,
    112.023,
    115.197
   ],
   "subs": [
    {
     "start": 105.259,
     "end": 108.159,
     "text": "Let's start with the biggest one. The costume."
    },
    {
     "start": 108.459,
     "end": 111.723,
     "text": "Costumes are where Americans spend the most on Halloween."
    },
    {
     "start": 112.023,
     "end": 114.897,
     "text": "About four point four billion dollars this year."
    },
    {
     "start": 115.197,
     "end": 118.094,
     "text": "And most of them get worn one single night."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 118.594,
   "end": 134.72,
   "line_starts": [
    118.594,
    122.195,
    126.309,
    130.817
   ],
   "subs": [
    {
     "start": 118.594,
     "end": 120.421,
     "text": "But before you bought anything,"
    },
    {
     "start": 120.421,
     "end": 121.895,
     "text": "you did one simple thing."
    },
    {
     "start": 122.195,
     "end": 123.657,
     "text": "You opened your closet."
    },
    {
     "start": 123.657,
     "end": 126.009,
     "text": "And you asked: what can I already be?"
    },
    {
     "start": 126.309,
     "end": 127.735,
     "text": "An old flannel shirt,"
    },
    {
     "start": 127.735,
     "end": 129.228,
     "text": "jeans and a straw hat?"
    },
    {
     "start": 129.228,
     "end": 130.517,
     "text": "That's a scarecrow."
    },
    {
     "start": 130.817,
     "end": 132.952,
     "text": "You didn't need a fancy costume."
    },
    {
     "start": 132.952,
     "end": 134.22,
     "text": "You needed an idea."
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 134.72,
   "end": 149.289,
   "line_starts": [
    134.72,
    138.95,
    142.42,
    147.254
   ],
   "subs": [
    {
     "start": 134.72,
     "end": 136.594,
     "text": "A white shirt and a little face"
    },
    {
     "start": 136.594,
     "end": 138.65,
     "text": "paint? That's a ghost or a zombie."
    },
    {
     "start": 138.95,
     "end": 142.12,
     "text": "A black sweater and cat ears? Done. Seriously."
    },
    {
     "start": 142.42,
     "end": 144.748,
     "text": "The best costumes are often the simple"
    },
    {
     "start": 144.748,
     "end": 146.954,
     "text": "ones people recognize in one second."
    },
    {
     "start": 147.254,
     "end": 148.789,
     "text": "No sewing. No stress."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 149.289,
   "end": 163.063,
   "line_starts": [
    149.289,
    152.854,
    157.059,
    161.479
   ],
   "subs": [
    {
     "start": 149.289,
     "end": 150.955,
     "text": "You spent twelve dollars."
    },
    {
     "start": 150.955,
     "end": 152.554,
     "text": "One prop. The straw hat."
    },
    {
     "start": 152.854,
     "end": 154.991,
     "text": "Mia spent one hundred eighty."
    },
    {
     "start": 154.991,
     "end": 156.759,
     "text": "Same party. Same photos."
    },
    {
     "start": 157.059,
     "end": 160.134,
     "text": "That's a one hundred sixty-eight dollar difference..."
    },
    {
     "start": 160.134,
     "end": 161.179,
     "text": "from one decision."
    },
    {
     "start": 161.479,
     "end": 162.563,
     "text": "Think about that."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 163.063,
   "end": 179.456,
   "line_starts": [
    163.063,
    166.746,
    172.85,
    175.343
   ],
   "subs": [
    {
     "start": 163.063,
     "end": 164.996,
     "text": "Don't want to make one yourself?"
    },
    {
     "start": 164.996,
     "end": 166.446,
     "text": "There are other options."
    },
    {
     "start": 166.746,
     "end": 168.572,
     "text": "A costume swap with friends."
    },
    {
     "start": 168.572,
     "end": 171.507,
     "text": "Everyone brings last year's costume and takes"
    },
    {
     "start": 171.507,
     "end": 172.55,
     "text": "a different one."
    },
    {
     "start": 172.85,
     "end": 175.043,
     "text": "Free. And honestly... kind of fun."
    },
    {
     "start": 175.343,
     "end": 177.408,
     "text": "You walk in with one costume and"
    },
    {
     "start": 177.408,
     "end": 178.956,
     "text": "walk out with a new one."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 179.456,
   "end": 200.011,
   "line_starts": [
    179.456,
    184.986,
    188.229,
    194.737
   ],
   "subs": [
    {
     "start": 179.456,
     "end": 181.52,
     "text": "Or check a thrift store first."
    },
    {
     "start": 181.52,
     "end": 184.686,
     "text": "Lots of costumes there were worn exactly once."
    },
    {
     "start": 184.986,
     "end": 186.273,
     "text": "And if you have kids,"
    },
    {
     "start": 186.273,
     "end": 187.929,
     "text": "this one matters even more."
    },
    {
     "start": 188.229,
     "end": 191.019,
     "text": "Kids outgrow costumes every single year."
    },
    {
     "start": 191.019,
     "end": 193.391,
     "text": "A swap with other parents can save"
    },
    {
     "start": 193.391,
     "end": 194.437,
     "text": "you real money."
    },
    {
     "start": 194.737,
     "end": 198.185,
     "text": "Last year's dinosaur becomes this year's dinosaur..."
    },
    {
     "start": 198.185,
     "end": 199.511,
     "text": "for a different kid."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 200.011,
   "end": 214.424,
   "line_starts": [
    200.011,
    201.994,
    206.615,
    210.045
   ],
   "subs": [
    {
     "start": 200.011,
     "end": 201.694,
     "text": "Move number two. Candy."
    },
    {
     "start": 201.994,
     "end": 204.994,
     "text": "Ninety-six percent of people planning to celebrate"
    },
    {
     "start": 204.994,
     "end": 206.315,
     "text": "said they'd buy candy."
    },
    {
     "start": 206.615,
     "end": 208.211,
     "text": "And this is where a lot of"
    },
    {
     "start": 208.211,
     "end": 209.745,
     "text": "money quietly disappears."
    },
    {
     "start": 210.045,
     "end": 212.231,
     "text": "Not because candy is expensive."
    },
    {
     "start": 212.231,
     "end": 213.924,
     "text": "Because nobody plans it."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 214.424,
   "end": 228.084,
   "line_starts": [
    214.424,
    217.12,
    220.169,
    223.617
   ],
   "subs": [
    {
     "start": 214.424,
     "end": 216.82,
     "text": "Mia bought candy three times this month."
    },
    {
     "start": 217.12,
     "end": 218.619,
     "text": "Once in early October..."
    },
    {
     "start": 218.619,
     "end": 219.869,
     "text": "and then she ate it."
    },
    {
     "start": 220.169,
     "end": 221.773,
     "text": "Then again two weeks later."
    },
    {
     "start": 221.773,
     "end": 223.317,
     "text": "And then she ate that too."
    },
    {
     "start": 223.617,
     "end": 225.27,
     "text": "Then one more time today,"
    },
    {
     "start": 225.27,
     "end": 227.584,
     "text": "at full price, at the corner store."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 228.084,
   "end": 240.915,
   "line_starts": [
    228.084,
    229.654,
    234.415,
    238.397
   ],
   "subs": [
    {
     "start": 228.084,
     "end": 229.354,
     "text": "You did it differently."
    },
    {
     "start": 229.654,
     "end": 231.276,
     "text": "First, you made a guess."
    },
    {
     "start": 231.276,
     "end": 234.115,
     "text": "How many kids came last year? About sixty."
    },
    {
     "start": 234.415,
     "end": 238.097,
     "text": "Two pieces each. That's around one hundred twenty pieces."
    },
    {
     "start": 238.397,
     "end": 240.415,
     "text": "Simple math. Two minutes. Done."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 240.915,
   "end": 259.199,
   "line_starts": [
    240.915,
    245.858,
    249.696,
    253.696
   ],
   "subs": [
    {
     "start": 240.915,
     "end": 242.946,
     "text": "Then you looked at the little price"
    },
    {
     "start": 242.946,
     "end": 243.933,
     "text": "tag on the shelf."
    },
    {
     "start": 243.933,
     "end": 245.558,
     "text": "The one with the unit price."
    },
    {
     "start": 245.858,
     "end": 248.347,
     "text": "Big bags are usually cheaper per piece"
    },
    {
     "start": 248.347,
     "end": 249.396,
     "text": "than small ones."
    },
    {
     "start": 249.696,
     "end": 251.482,
     "text": "But you only buy the big bag"
    },
    {
     "start": 251.482,
     "end": 253.396,
     "text": "if you'll actually use it all."
    },
    {
     "start": 253.696,
     "end": 256.165,
     "text": "Store brands and mixed packs are often"
    },
    {
     "start": 256.165,
     "end": 258.699,
     "text": "cheaper too. Kids don't check the logo."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 259.199,
   "end": 274.167,
   "line_starts": [
    259.199,
    261.789,
    266.348,
    270.018
   ],
   "subs": [
    {
     "start": 259.199,
     "end": 261.489,
     "text": "And here's the rule that saved you the most."
    },
    {
     "start": 261.789,
     "end": 264.557,
     "text": "You bought the candy on Halloween week."
    },
    {
     "start": 264.557,
     "end": 266.048,
     "text": "Not in early October."
    },
    {
     "start": 266.348,
     "end": 268.404,
     "text": "Candy you don't have in the house..."
    },
    {
     "start": 268.404,
     "end": 269.718,
     "text": "is candy you don't eat."
    },
    {
     "start": 270.018,
     "end": 272.025,
     "text": "Wait until the week of Halloween."
    },
    {
     "start": 272.025,
     "end": 273.667,
     "text": "Your wallet will thank you."
    }
   ]
  },
  {
   "id": "s18",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 274.167,
   "end": 284.723,
   "line_starts": [
    274.167,
    277.777,
    280.267,
    282.318
   ],
   "subs": [
    {
     "start": 274.167,
     "end": 277.477,
     "text": "Your candy budget? Twenty-four dollars. One trip."
    },
    {
     "start": 277.777,
     "end": 279.967,
     "text": "Mia's? Forty-five. Three trips."
    },
    {
     "start": 280.267,
     "end": 282.018,
     "text": "And she's still buying more tonight."
    },
    {
     "start": 282.318,
     "end": 284.223,
     "text": "Same kids. Same smiles."
    }
   ]
  },
  {
   "id": "s19",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 284.723,
   "end": 300.742,
   "line_starts": [
    284.723,
    287.157,
    293.853,
    297.209
   ],
   "subs": [
    {
     "start": 284.723,
     "end": 286.857,
     "text": "Move number three. Decorations."
    },
    {
     "start": 287.157,
     "end": 289.907,
     "text": "Americans planned to spend about four point"
    },
    {
     "start": 289.907,
     "end": 293.553,
     "text": "three billion dollars on Halloween decorations this year."
    },
    {
     "start": 293.853,
     "end": 295.248,
     "text": "But here's the thing."
    },
    {
     "start": 295.248,
     "end": 296.909,
     "text": "Decorations don't expire."
    },
    {
     "start": 297.209,
     "end": 298.422,
     "text": "You buy them once."
    },
    {
     "start": 298.422,
     "end": 300.242,
     "text": "You can use them for years."
    }
   ]
  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 300.742,
   "end": 313.598,
   "line_starts": [
    300.742,
    305.047,
    309.031
   ],
   "subs": [
    {
     "start": 300.742,
     "end": 302.486,
     "text": "Last year, after Halloween,"
    },
    {
     "start": 302.486,
     "end": 304.747,
     "text": "you packed everything into one bin."
    },
    {
     "start": 305.047,
     "end": 306.833,
     "text": "You drew a little pumpkin on the"
    },
    {
     "start": 306.833,
     "end": 308.731,
     "text": "lid. And you put it in the closet."
    },
    {
     "start": 309.031,
     "end": 310.945,
     "text": "So this year, you didn't buy the"
    },
    {
     "start": 310.945,
     "end": 313.098,
     "text": "same skeleton... for the third time."
    }
   ]
  },
  {
   "id": "s21",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 313.598,
   "end": 325.768,
   "line_starts": [
    313.598,
    316.613,
    320.227,
    323.461
   ],
   "subs": [
    {
     "start": 313.598,
     "end": 316.313,
     "text": "Mia? She couldn't find last year's decorations."
    },
    {
     "start": 316.613,
     "end": 319.927,
     "text": "They're somewhere. Behind the vacuum cleaner probably."
    },
    {
     "start": 320.227,
     "end": 323.161,
     "text": "So she bought them all again. Ninety dollars."
    },
    {
     "start": 323.461,
     "end": 325.268,
     "text": "Sound familiar? Be honest."
    }
   ]
  },
  {
   "id": "s22",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 325.768,
   "end": 339.79,
   "line_starts": [
    325.768,
    328.069,
    335.086
   ],
   "subs": [
    {
     "start": 325.768,
     "end": 327.769,
     "text": "You added a few cheap touches too."
    },
    {
     "start": 328.069,
     "end": 330.457,
     "text": "Paper bats cut from black paper."
    },
    {
     "start": 330.457,
     "end": 333.218,
     "text": "A few glass jars with candles inside."
    },
    {
     "start": 333.218,
     "end": 334.786,
     "text": "Leaves from the yard."
    },
    {
     "start": 335.086,
     "end": 337.621,
     "text": "It looked cozy. It looked like Halloween."
    },
    {
     "start": 337.621,
     "end": 339.29,
     "text": "And it cost almost nothing."
    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 339.79,
   "end": 354.888,
   "line_starts": [
    339.79,
    341.915,
    346.381,
    351.953
   ],
   "subs": [
    {
     "start": 339.79,
     "end": 341.615,
     "text": "Move number four. The pumpkin."
    },
    {
     "start": 341.915,
     "end": 343.767,
     "text": "Pumpkin patches are fun."
    },
    {
     "start": 343.767,
     "end": 346.081,
     "text": "Hayrides, photos, apple cider."
    },
    {
     "start": 346.381,
     "end": 348.22,
     "text": "But if you just need a pumpkin"
    },
    {
     "start": 348.22,
     "end": 350.488,
     "text": "for the porch... the grocery store is"
    },
    {
     "start": 350.488,
     "end": 351.653,
     "text": "often much cheaper."
    },
    {
     "start": 351.953,
     "end": 353.196,
     "text": "Nothing wrong with that,"
    },
    {
     "start": 353.196,
     "end": 354.388,
     "text": "if it's in your budget."
    }
   ]
  },
  {
   "id": "s24",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 354.888,
   "end": 365.179,
   "line_starts": [
    354.888,
    359.022,
    362.479
   ],
   "subs": [
    {
     "start": 354.888,
     "end": 356.276,
     "text": "You paid six dollars."
    },
    {
     "start": 356.276,
     "end": 358.722,
     "text": "You carved it with friends on Sunday."
    },
    {
     "start": 359.022,
     "end": 360.826,
     "text": "And you roasted the seeds in the"
    },
    {
     "start": 360.826,
     "end": 362.179,
     "text": "oven with a little salt."
    },
    {
     "start": 362.479,
     "end": 364.679,
     "text": "A free snack. Seriously, try it."
    }
   ]
  },
  {
   "id": "s25",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 365.179,
   "end": 377.645,
   "line_starts": [
    365.179,
    371.6,
    372.986
   ],
   "subs": [
    {
     "start": 365.179,
     "end": 367.405,
     "text": "Mia went to a pumpkin patch with"
    },
    {
     "start": 367.405,
     "end": 368.935,
     "text": "an entry fee, parking,"
    },
    {
     "start": 368.935,
     "end": 371.3,
     "text": "and a pumpkin priced by the pound."
    },
    {
     "start": 371.6,
     "end": 372.686,
     "text": "Thirty dollars."
    },
    {
     "start": 372.986,
     "end": 374.571,
     "text": "It was a nice afternoon."
    },
    {
     "start": 374.571,
     "end": 377.145,
     "text": "But it wasn't the only way to have one."
    }
   ]
  },
  {
   "id": "s26",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 377.645,
   "end": 387.148,
   "line_starts": [
    377.645,
    379.772,
    383.439
   ],
   "subs": [
    {
     "start": 377.645,
     "end": 379.472,
     "text": "Move number five. The party."
    },
    {
     "start": 379.772,
     "end": 382.017,
     "text": "You didn't host everything yourself."
    },
    {
     "start": 382.017,
     "end": 383.139,
     "text": "You did a potluck."
    },
    {
     "start": 383.439,
     "end": 384.635,
     "text": "You made the chili."
    },
    {
     "start": 384.635,
     "end": 386.648,
     "text": "Everyone else brought one thing."
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 387.148,
   "end": 401.277,
   "line_starts": [
    387.148,
    390.36,
    394.257,
    397.726
   ],
   "subs": [
    {
     "start": 387.148,
     "end": 388.865,
     "text": "Ten people. Ten dishes."
    },
    {
     "start": 388.865,
     "end": 390.06,
     "text": "One great table."
    },
    {
     "start": 390.36,
     "end": 391.662,
     "text": "And the cost for you?"
    },
    {
     "start": 391.662,
     "end": 393.957,
     "text": "The ingredients for one pot of chili."
    },
    {
     "start": 394.257,
     "end": 397.426,
     "text": "Nobody felt cheap. Everyone felt included."
    },
    {
     "start": 397.726,
     "end": 399.998,
     "text": "And honestly? It was the best party"
    },
    {
     "start": 399.998,
     "end": 400.777,
     "text": "of the year."
    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 401.277,
   "end": 413.002,
   "line_starts": [
    401.277,
    403.847,
    405.935,
    409.256
   ],
   "subs": [
    {
     "start": 401.277,
     "end": 403.547,
     "text": "Then you set one simple rule for the night."
    },
    {
     "start": 403.847,
     "end": 405.635,
     "text": "You leave the credit card at home."
    },
    {
     "start": 405.935,
     "end": 407.23,
     "text": "You bring a little cash."
    },
    {
     "start": 407.23,
     "end": 408.956,
     "text": "And when it's gone... it's gone."
    },
    {
     "start": 409.256,
     "end": 412.502,
     "text": "No late-night pizza order you'll regret tomorrow."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 413.002,
   "end": 422.106,
   "line_starts": [
    413.002,
    414.573,
    418.937
   ],
   "subs": [
    {
     "start": 413.002,
     "end": 414.273,
     "text": "Now let's add it up."
    },
    {
     "start": 414.573,
     "end": 416.783,
     "text": "Costume: twelve dollars. Candy:"
    },
    {
     "start": 416.783,
     "end": 418.637,
     "text": "twenty-four. Pumpkin: six."
    },
    {
     "start": 418.937,
     "end": 421.606,
     "text": "Decorations: zero. You already had them."
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 422.106,
   "end": 432.677,
   "line_starts": [
    422.106,
    424.65,
    427.537
   ],
   "subs": [
    {
     "start": 422.106,
     "end": 424.35,
     "text": "Your Halloween: forty-two dollars."
    },
    {
     "start": 424.65,
     "end": 427.237,
     "text": "Mia's Halloween: four hundred and ten."
    },
    {
     "start": 427.537,
     "end": 429.013,
     "text": "Same night. Same fun."
    },
    {
     "start": 429.013,
     "end": 432.177,
     "text": "Three hundred sixty-eight dollars difference."
    }
   ]
  },
  {
   "id": "s31",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 432.677,
   "end": 447.452,
   "line_starts": [
    432.677,
    436.071,
    440.01,
    444.099
   ],
   "subs": [
    {
     "start": 432.677,
     "end": 434.784,
     "text": "And if Mia only pays the minimum"
    },
    {
     "start": 434.784,
     "end": 435.771,
     "text": "on that card..."
    },
    {
     "start": 436.071,
     "end": 439.71,
     "text": "that Halloween follows her around for months. With interest."
    },
    {
     "start": 440.01,
     "end": 441.462,
     "text": "Halloween is one night."
    },
    {
     "start": 441.462,
     "end": 443.799,
     "text": "The bill shouldn't last until spring."
    },
    {
     "start": 444.099,
     "end": 445.38,
     "text": "Every month she waits,"
    },
    {
     "start": 445.38,
     "end": 446.952,
     "text": "the interest keeps growing."
    }
   ]
  },
  {
   "id": "s32",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 447.452,
   "end": 456.376,
   "line_starts": [
    447.452,
    449.786,
    452.423
   ],
   "subs": [
    {
     "start": 447.452,
     "end": 449.486,
     "text": "Okay. Now the move I promised you."
    },
    {
     "start": 449.786,
     "end": 452.123,
     "text": "Tomorrow morning is November first."
    },
    {
     "start": 452.423,
     "end": 454.706,
     "text": "And that's when Halloween stores start to"
    },
    {
     "start": 454.706,
     "end": 455.876,
     "text": "clear everything out."
    }
   ]
  },
  {
   "id": "s33",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 456.376,
   "end": 473.083,
   "line_starts": [
    456.376,
    461.137,
    464.157,
    467.998
   ],
   "subs": [
    {
     "start": 456.376,
     "end": 460.837,
     "text": "Decorations, costumes, lights... often half off on November first."
    },
    {
     "start": 461.137,
     "end": 463.857,
     "text": "And sometimes even cheaper a few days later."
    },
    {
     "start": 464.157,
     "end": 465.6,
     "text": "So you go with a list."
    },
    {
     "start": 465.6,
     "end": 467.698,
     "text": "Not a cart full of random stuff."
    },
    {
     "start": 467.998,
     "end": 469.725,
     "text": "Not because they're generous."
    },
    {
     "start": 469.725,
     "end": 472.583,
     "text": "Because they need the shelf space for Christmas."
    }
   ]
  },
  {
   "id": "s34",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 473.083,
   "end": 485.39,
   "line_starts": [
    473.083,
    476.687,
    481.807
   ],
   "subs": [
    {
     "start": 473.083,
     "end": 475.514,
     "text": "You buy the one thing you'll definitely"
    },
    {
     "start": 475.514,
     "end": 476.387,
     "text": "use next year."
    },
    {
     "start": 476.687,
     "end": 478.891,
     "text": "Maybe a string of orange lights."
    },
    {
     "start": 478.891,
     "end": 481.507,
     "text": "Maybe a kid's costume one size bigger."
    },
    {
     "start": 481.807,
     "end": 483.475,
     "text": "And it goes straight into the bin"
    },
    {
     "start": 483.475,
     "end": 484.89,
     "text": "with the pumpkin on the lid."
    }
   ]
  },
  {
   "id": "s35",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 485.39,
   "end": 497.91,
   "line_starts": [
    485.39,
    487.071,
    491.013,
    495.823
   ],
   "subs": [
    {
     "start": 485.39,
     "end": 486.771,
     "text": "And the leftover candy?"
    },
    {
     "start": 487.071,
     "end": 489.662,
     "text": "After Halloween, a lot of stores mark"
    },
    {
     "start": 489.662,
     "end": 490.713,
     "text": "candy down too."
    },
    {
     "start": 491.013,
     "end": 493.297,
     "text": "If you're going to buy chocolate anyway"
    },
    {
     "start": 493.297,
     "end": 495.523,
     "text": "in November... that's when you buy it."
    },
    {
     "start": 495.823,
     "end": 497.41,
     "text": "Just don't buy it before."
    }
   ]
  },
  {
   "id": "s36",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 497.91,
   "end": 509.251,
   "line_starts": [
    497.91,
    499.44,
    503.906
   ],
   "subs": [
    {
     "start": 497.91,
     "end": 499.14,
     "text": "But here's the warning."
    },
    {
     "start": 499.44,
     "end": 501.725,
     "text": "A discount only saves money if you"
    },
    {
     "start": 501.725,
     "end": 503.606,
     "text": "were going to buy it anyway."
    },
    {
     "start": 503.906,
     "end": 506.666,
     "text": "Fifty percent off something you don't need..."
    },
    {
     "start": 506.666,
     "end": 508.751,
     "text": "is still a hundred percent wasted."
    }
   ]
  },
  {
   "id": "s37",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 509.251,
   "end": 521.717,
   "line_starts": [
    509.251,
    511.129,
    515.843,
    518.389
   ],
   "subs": [
    {
     "start": 509.251,
     "end": 510.829,
     "text": "And then you do one last thing."
    },
    {
     "start": 511.129,
     "end": 513.14,
     "text": "You open your banking app and create"
    },
    {
     "start": 513.14,
     "end": 515.543,
     "text": "a little savings bucket called 'Halloween'."
    },
    {
     "start": 515.843,
     "end": 518.089,
     "text": "Ten dollars a month. Automatically."
    },
    {
     "start": 518.389,
     "end": 520.374,
     "text": "You named it, so you know exactly"
    },
    {
     "start": 520.374,
     "end": 521.217,
     "text": "what it's for."
    }
   ]
  },
  {
   "id": "s38",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 521.717,
   "end": 532.667,
   "line_starts": [
    521.717,
    525.783,
    527.439
   ],
   "subs": [
    {
     "start": 521.717,
     "end": 524.208,
     "text": "By next October, there's one hundred twenty"
    },
    {
     "start": 524.208,
     "end": 525.483,
     "text": "dollars sitting there."
    },
    {
     "start": 525.783,
     "end": 527.139,
     "text": "Cash. Already saved."
    },
    {
     "start": 527.439,
     "end": 530.694,
     "text": "So next Halloween costs you nothing extra."
    },
    {
     "start": 530.694,
     "end": 532.167,
     "text": "No card. No stress."
    }
   ]
  },
  {
   "id": "s39",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 532.667,
   "end": 547.045,
   "line_starts": [
    532.667,
    534.548,
    538.209,
    543.729
   ],
   "subs": [
    {
     "start": 532.667,
     "end": 534.248,
     "text": "It's called a sinking fund."
    },
    {
     "start": 534.548,
     "end": 536.337,
     "text": "You save a little every month for"
    },
    {
     "start": 536.337,
     "end": 537.909,
     "text": "something you know is coming."
    },
    {
     "start": 538.209,
     "end": 541.524,
     "text": "Halloween. Christmas. Birthdays. Car insurance."
    },
    {
     "start": 541.524,
     "end": 543.429,
     "text": "None of them are surprises."
    },
    {
     "start": 543.729,
     "end": 545.22,
     "text": "You already know the dates."
    },
    {
     "start": 545.22,
     "end": 546.545,
     "text": "They're on the calendar."
    }
   ]
  },
  {
   "id": "s40",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 547.045,
   "end": 555.304,
   "line_starts": [
    547.045,
    551.064,
    553.925
   ],
   "subs": [
    {
     "start": 547.045,
     "end": 549.104,
     "text": "And they only feel like surprises..."
    },
    {
     "start": 549.104,
     "end": 550.764,
     "text": "when you don't plan for them."
    },
    {
     "start": 551.064,
     "end": 553.625,
     "text": "That's why Mia feels broke every November."
    },
    {
     "start": 553.925,
     "end": 554.804,
     "text": "And you don't."
    }
   ]
  },
  {
   "id": "s41",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 555.304,
   "end": 565.14,
   "line_starts": [
    555.304,
    556.976,
    561.105,
    562.636
   ],
   "subs": [
    {
     "start": 555.304,
     "end": 556.676,
     "text": "So tonight, enjoy it."
    },
    {
     "start": 556.976,
     "end": 558.23,
     "text": "Hand out the candy."
    },
    {
     "start": 558.23,
     "end": 559.353,
     "text": "Eat a few pieces."
    },
    {
     "start": 559.353,
     "end": 560.805,
     "text": "Laugh at the costumes."
    },
    {
     "start": 561.105,
     "end": 562.336,
     "text": "You earned this night."
    },
    {
     "start": 562.636,
     "end": 564.64,
     "text": "Tomorrow is for the smart moves."
    }
   ]
  },
  {
   "id": "s42",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 565.14,
   "end": 576.379,
   "line_starts": [
    565.14,
    567.469,
    570.461,
    573.464
   ],
   "subs": [
    {
     "start": 565.14,
     "end": 567.169,
     "text": "And tomorrow, three small moves."
    },
    {
     "start": 567.469,
     "end": 570.161,
     "text": "Pack the decorations in one labeled bin."
    },
    {
     "start": 570.461,
     "end": 572.474,
     "text": "Buy only what you'll use next year,"
    },
    {
     "start": 572.474,
     "end": 573.164,
     "text": "from a list."
    },
    {
     "start": 573.464,
     "end": 575.879,
     "text": "And start that ten-dollar Halloween fund."
    }
   ]
  },
  {
   "id": "s43",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 576.379,
   "end": 589.264,
   "line_starts": [
    576.379,
    580.345,
    584.288
   ],
   "subs": [
    {
     "start": 576.379,
     "end": 578.783,
     "text": "If this helped, subscribe for one simple"
    },
    {
     "start": 578.783,
     "end": 580.045,
     "text": "money move every day."
    },
    {
     "start": 580.345,
     "end": 582.027,
