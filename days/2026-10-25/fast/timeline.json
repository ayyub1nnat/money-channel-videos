    },
    {
     "start": 62.695,
     "end": 65.072,
     "text": "Many banks offer accounts without them."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "Daily extras",
   "start": 65.422,
   "end": 69.867,
   "line_starts": [
    65.422
   ],
   "subs": [
    {
     "start": 65.422,
     "end": 67.283,
     "text": "And those little daily extras."
    },
    {
     "start": 67.283,
     "end": 69.517,
     "text": "Snacks, delivery fees, impulse buys."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "$720 a year",
   "start": 69.867,
   "end": 73.91,
   "line_starts": [
    69.867
   ],
   "subs": [
    {
