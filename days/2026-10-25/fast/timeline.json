    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "Automate it",
   "start": 91.643,
   "end": 94.689,
   "line_starts": [
    91.643
   ],
   "subs": [
    {
     "start": 91.643,
     "end": 94.339,
