  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "$25 a week",
   "start": 82.34,
   "end": 84.947,
   "line_starts": [
    82.34
   ],
   "subs": [
    {
     "start": 82.34,
     "end": 83.337,
