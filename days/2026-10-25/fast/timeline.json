{
 "title": "How to Build an Emergency Fund on a Low Income (Step by Step)",
 "duration": 181.318,
 "scenes": [
  {
   "id": "s0",
   "visual": "sketch",
   "params": {},
   "heading": "Your car just broke",
   "start": 0.3,
   "end": 5.114,
   "line_starts": [
    0.3
   ],
   "subs": [
    {
     "start": 0.3,
     "end": 2.303,
     "text": "Imagine this. Your car breaks down,"
    },
    {
     "start": 2.303,
     "end": 3.562,
     "text": "and the mechanic says:"
    },
    {
     "start": 3.562,
     "end": 4.764,
     "text": "four hundred dollars."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "Could you pay it?",
   "start": 5.114,
   "end": 7.858,
   "line_starts": [
    5.114
   ],
   "subs": [
    {
     "start": 5.114,
     "end": 6.561,
     "text": "Could you pay that right now,"
    },
    {
     "start": 6.561,
     "end": 7.508,
     "text": "in cash? Be honest."
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "You're not alone",
   "start": 7.858,
   "end": 11.35,
   "line_starts": [
    7.858
   ],
   "subs": [
    {
     "start": 7.858,
     "end": 9.044,
     "text": "If the answer is no,"
    },
    {
     "start": 9.044,
     "end": 10.111,
     "text": "you are not alone."
    },
    {
     "start": 10.111,
     "end": 11.0,
     "text": "Not even close."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "1 in 3",
   "start": 11.35,
   "end": 16.442,
   "line_starts": [
    11.35
   ],
   "subs": [
    {
     "start": 11.35,
     "end": 13.206,
     "text": "More than a third of American adults"
    },
    {
     "start": 13.206,
     "end": 16.092,
     "text": "couldn't cover a four hundred dollar surprise with cash."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "Here's the fix",
   "start": 16.442,
   "end": 21.405,
   "line_starts": [
    16.442
   ],
   "subs": [
    {
     "start": 16.442,
     "end": 18.194,
     "text": "So today, I'll show you how to"
    },
    {
     "start": 18.194,
     "end": 19.595,
     "text": "build an emergency fund,"
    },
    {
     "start": 19.595,
     "end": 21.055,
     "text": "even on a small paycheck."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "The debt trap",
   "start": 21.405,
   "end": 26.04,
   "line_starts": [
    21.405
   ],
   "subs": [
    {
     "start": 21.405,
     "end": 23.119,
     "text": "Here's what happens without one."
    },
    {
     "start": 23.119,
     "end": 25.69,
     "text": "Every surprise goes straight onto a credit card."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "It snowballs",
   "start": 26.04,
   "end": 30.178,
   "line_starts": [
    26.04
   ],
   "subs": [
    {
     "start": 26.04,
     "end": 28.15,
     "text": "Then the interest makes next month even"
    },
    {
     "start": 28.15,
     "end": 29.828,
     "text": "tighter. And the cycle repeats."
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "Not your fault",
   "start": 30.178,
   "end": 34.076,
   "line_starts": [
    30.178
   ],
   "subs": [
    {
     "start": 30.178,
     "end": 32.275,
     "text": "It's not because you're bad with money."
    },
    {
     "start": 32.275,
     "end": 33.726,
     "text": "Life is just unpredictable."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "Break the cycle",
   "start": 34.076,
   "end": 37.703,
   "line_starts": [
    34.076
   ],
   "subs": [
    {
     "start": 34.076,
     "end": 36.322,
     "text": "An emergency fund is the wall between"
    },
    {
     "start": 36.322,
     "end": 37.353,
     "text": "you and new debt."
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "Forget 6 months",
   "start": 37.703,
   "end": 43.143,
   "line_starts": [
    37.703
   ],
   "subs": [
    {
     "start": 37.703,
     "end": 39.705,
     "text": "You've heard you need six months of"
    },
    {
     "start": 39.705,
     "end": 41.535,
     "text": "expenses saved. On a low income,"
    },
    {
     "start": 41.535,
     "end": 42.793,
     "text": "that feels impossible."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "Start small",
   "start": 43.143,
   "end": 47.251,
   "line_starts": [
    43.143
   ],
   "subs": [
    {
     "start": 43.143,
     "end": 44.414,
     "text": "So forget that for now."
    },
    {
     "start": 44.414,
     "end": 46.901,
     "text": "Your first goal is just five hundred dollars."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "$500 = peace",
   "start": 47.251,
   "end": 51.543,
   "line_starts": [
    47.251
   ],
   "subs": [
    {
     "start": 47.251,
     "end": 49.022,
     "text": "That alone covers a car repair,"
    },
    {
     "start": 49.022,
     "end": 50.108,
     "text": "a new phone screen,"
    },
    {
     "start": 50.108,
     "end": 51.193,
     "text": "or a surprise bill."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "Then level up",
   "start": 51.543,
   "end": 54.321,
   "line_starts": [
    51.543
   ],
   "subs": [
    {
     "start": 51.543,
     "end": 53.971,
     "text": "Hit it? Great. Now aim for one thousand."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "Money leaks",
   "start": 54.321,
   "end": 57.347,
   "line_starts": [
    54.321
   ],
   "subs": [
    {
     "start": 54.321,
     "end": 56.997,
     "text": "Step two. Find the money that's already slipping away."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "Forgotten apps",
   "start": 57.347,
   "end": 60.44,
   "line_starts": [
    57.347
   ],
   "subs": [
    {
     "start": 57.347,
     "end": 59.015,
     "text": "Subscriptions you forgot about."
    },
    {
     "start": 59.015,
     "end": 60.09,
     "text": "Apps you never open."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "Bank fees?!",
   "start": 60.44,
   "end": 65.422,
   "line_starts": [
    60.44
   ],
   "subs": [
    {
