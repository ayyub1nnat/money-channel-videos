   "start": 104.065,
   "end": 107.156,
   "line_starts": [
    104.065
   ],
   "subs": [
    {
     "start": 104.065,
     "end": 105.729,
     "text": "Money you never see in checking is"
    },
    {
     "start": 105.729,
     "end": 106.806,
     "text": "money you won't spend."
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "Keep it apart",
   "start": 107.156,
   "end": 109.761,
   "line_starts": [
    107.156
   ],
   "subs": [
    {
     "start": 107.156,
     "end": 109.411,
