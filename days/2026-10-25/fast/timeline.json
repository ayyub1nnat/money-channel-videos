     "end": 115.506,
     "text": "Put it in a separate savings account,"
    },
    {
     "start": 115.506,
     "end": 117.907,
     "text": "ideally high yield, at a federally insured"
    },
    {
     "start": 117.907,
     "end": 119.107,
     "text": "bank or credit union."
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "Don't invest it",
   "start": 119.457,
   "end": 124.107,
   "line_starts": [
    119.457
   ],
   "subs": [
    {
     "start": 119.457,
     "end": 120.545,
     "text": "And don't invest it."
    },
    {
