    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "Not in checking",
   "start": 109.761,
   "end": 113.392,
   "line_starts": [
    109.761
   ],
   "subs": [
    {
     "start": 109.761,
     "end": 111.606,
     "text": "If it sits in your checking account,"
    },
    {
     "start": 111.606,
     "end": 113.042,
     "text": "it will disappear. Trust me."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "Separate savings",
   "start": 113.392,
   "end": 119.457,
