   ],
   "subs": [
    {
     "start": 0.1,
     "end": 1.527,
     "text": "It's a Tuesday morning."
    },
    {
     "start": 1.527,
     "end": 3.327,
     "text": "Your car makes a sound it has"
    },
    {
     "start": 3.327,
     "end": 4.444,
     "text": "never made before."
    },
    {
     "start": 4.624,
     "end": 6.569,
     "text": "A loud, ugly grinding sound."
    },
    {
     "start": 6.749,
     "end": 9.047,
     "text": "Two hours later, the mechanic says it."
    },
    {
     "start": 9.047,
     "end": 10.256,
     "text": "Six hundred dollars."
    },
    {
     "start": 10.436,
     "end": 11.622,
     "text": "And you... just nod."
    },
    {
     "start": 11.622,
     "end": 12.927,
     "text": "You don't even flinch."
    }
   ]
  },
  {
   "id": "s1",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 13.207,
   "end": 26.055,
   "line_starts": [
    13.207,
    16.345,
    21.143,
    23.152
   ],
   "subs": [
    {
     "start": 13.207,
     "end": 14.716,
     "text": "Because three months ago,"
    },
    {
     "start": 14.716,
     "end": 16.165,
     "text": "you started a tiny plan."
    },
    {
     "start": 16.345,
     "end": 18.772,
     "text": "And today, sitting in a separate account,"
    },
    {
     "start": 18.772,
     "end": 20.963,
     "text": "there's exactly one thousand dollars."
    },
    {
     "start": 21.143,
     "end": 22.972,
     "text": "Your first thousand. Your shield."
    },
    {
     "start": 23.152,
     "end": 25.775,
     "text": "And that changes everything about this Tuesday."
    }
   ]
  },
  {
   "id": "s2",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 26.055,
   "end": 39.014,
   "line_starts": [
    26.055,
    30.204,
    34.843,
    37.374
   ],
   "subs": [
    {
     "start": 26.055,
     "end": 27.892,
     "text": "Now meet Jake. Same week."
    },
    {
     "start": 27.892,
     "end": 30.024,
     "text": "Same kind of car. Same sound."
    },
    {
     "start": 30.204,
     "end": 32.281,
     "text": "Jake actually earns more than you."
    },
    {
     "start": 32.281,
     "end": 34.663,
     "text": "Nine hundred dollars more, every month."
    },
    {
     "start": 34.843,
     "end": 37.194,
     "text": "But when the mechanic says six hundred dollars..."
    },
    {
     "start": 37.374,
     "end": 38.734,
     "text": "Jake's stomach drops."
    }
   ]
  },
  {
   "id": "s3",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 39.014,
   "end": 49.532,
   "line_starts": [
    39.014,
    42.365,
    44.272
   ],
   "subs": [
    {
     "start": 39.014,
     "end": 40.364,
     "text": "He checks his bank app."
    },
    {
     "start": 40.364,
     "end": 42.185,
     "text": "Two hundred and twelve dollars."
    },
    {
     "start": 42.365,
     "end": 44.092,
     "text": "Rent is due in nine days."
    },
    {
     "start": 44.272,
     "end": 46.067,
     "text": "So he does what most people do."
    },
    {
     "start": 46.067,
     "end": 47.92,
     "text": "He hands over the credit card..."
    },
    {
     "start": 47.92,
     "end": 49.252,
     "text": "and hopes for the best."
    }
   ]
  },
  {
   "id": "s4",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 49.532,
   "end": 62.875,
   "line_starts": [
    49.532,
    51.71,
    55.796,
    60.252
   ],
   "subs": [
    {
     "start": 49.532,
     "end": 51.53,
     "text": "And here's the part nobody tells you."
    },
    {
     "start": 51.71,
     "end": 53.491,
     "text": "At twenty-two percent interest,"
    },
    {
     "start": 53.491,
     "end": 55.616,
     "text": "paying twenty-five dollars a month..."
    },
    {
     "start": 55.796,
     "end": 59.048,
     "text": "that six-hundred-dollar repair takes Jake almost three"
    },
    {
     "start": 59.048,
     "end": 60.072,
     "text": "years to pay off."
    },
    {
     "start": 60.252,
     "end": 62.595,
     "text": "And it costs him about eight hundred dollars."
    }
   ]
  },
  {
   "id": "s5",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 62.875,
   "end": 74.249,
   "line_starts": [
    62.875,
    64.711,
    66.791,
    71.174
   ],
   "subs": [
    {
     "start": 62.875,
     "end": 64.531,
     "text": "Same repair. Same week."
    },
    {
     "start": 64.711,
     "end": 66.611,
     "text": "For you, it's an annoying Tuesday."
    },
    {
     "start": 66.791,
     "end": 69.673,
     "text": "For Jake, it's a two-hundred-dollar mistake that"
    },
    {
     "start": 69.673,
     "end": 70.994,
     "text": "follows him for years."
    },
    {
     "start": 71.174,
     "end": 73.398,
     "text": "And the only difference between them..."
    },
    {
     "start": 73.398,
     "end": 73.969,
     "text": "is a plan."
    }
   ]
  },
  {
   "id": "s6",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 74.249,
   "end": 87.959,
   "line_starts": [
    74.249,
    77.06,
    86.587
   ],
   "subs": [
    {
     "start": 74.249,
     "end": 75.813,
     "text": "And Jake is not alone."
    },
    {
     "start": 75.813,
     "end": 76.88,
     "text": "Not even close."
    },
    {
     "start": 77.06,
     "end": 79.965,
     "text": "In Bankrate's latest emergency savings survey,"
    },
    {
     "start": 79.965,
     "end": 82.428,
     "text": "fewer than half of American adults said"
    },
    {
     "start": 82.428,
     "end": 86.407,
     "text": "they could cover a thousand-dollar surprise from their savings."
    },
    {
     "start": 86.587,
     "end": 87.679,
     "text": "Fewer than half!"
    }
   ]
  },
  {
   "id": "s7",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 87.959,
   "end": 103.061,
   "line_starts": [
    87.959,
    89.23,
    95.355,
    99.523
   ],
   "subs": [
    {
     "start": 87.959,
     "end": 89.05,
     "text": "So stay with me."
    },
    {
     "start": 89.23,
     "end": 91.059,
     "text": "Because in the next few minutes,"
    },
    {
     "start": 91.059,
     "end": 92.946,
     "text": "I'll show you exactly how you got"
    },
    {
     "start": 92.946,
     "end": 95.175,
     "text": "to one thousand dollars in ninety days."
    },
    {
     "start": 95.355,
     "end": 96.431,
     "text": "Not with a raise."
    },
    {
     "start": 96.431,
     "end": 98.014,
     "text": "Not with a side business."
    },
    {
     "start": 98.014,
     "end": 99.343,
     "text": "With six small moves."
    },
    {
     "start": 99.523,
     "end": 100.629,
     "text": "Stay till the end,"
    },
    {
     "start": 100.629,
     "end": 102.781,
     "text": "because the math surprised even me."
    }
   ]
  },
  {
   "id": "s8",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 103.061,
   "end": 116.659,
   "line_starts": [
    103.061,
    105.482,
    109.102,
    112.919
   ],
   "subs": [
    {
     "start": 103.061,
     "end": 105.302,
     "text": "Let's rewind. Ninety days earlier."
    },
    {
     "start": 105.482,
     "end": 108.922,
     "text": "You earn thirty-two hundred dollars a month after taxes."
    },
    {
     "start": 109.102,
     "end": 110.786,
     "text": "Rent, car, phone, food..."
    },
    {
     "start": 110.786,
     "end": 112.739,
     "text": "it all goes out. Every month."
    },
    {
     "start": 112.919,
     "end": 114.344,
     "text": "And at the end of the month,"
    },
    {
     "start": 114.344,
     "end": 116.379,
     "text": "there's... nothing left. Sound familiar?"
    }
   ]
  },
  {
   "id": "s9",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 116.659,
   "end": 129.615,
   "line_starts": [
    116.659,
    121.611,
    124.605,
    127.576
   ],
   "subs": [
    {
     "start": 116.659,
     "end": 119.31,
     "text": "You'd read about emergency funds before."
    },
    {
     "start": 119.31,
     "end": 121.431,
     "text": "Three to six months of expenses."
    },
    {
     "start": 121.611,
     "end": 123.806,
     "text": "And honestly? That number made you want"
    },
    {
     "start": 123.806,
     "end": 124.425,
     "text": "to give up."
    },
    {
     "start": 124.605,
     "end": 126.387,
     "text": "Ten thousand dollars? Fifteen?"
    },
    {
     "start": 126.387,
     "end": 127.396,
     "text": "On your paycheck?"
    },
    {
     "start": 127.576,
     "end": 129.335,
     "text": "So you just... never started."
    }
   ]
  },
  {
   "id": "s10",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 129.615,
   "end": 144.799,
   "line_starts": [
    129.615,
    132.368,
    135.385,
    142.297
   ],
   "subs": [
    {
     "start": 129.615,
     "end": 132.188,
     "text": "So you made one decision that changed everything."
    },
    {
     "start": 132.368,
     "end": 135.205,
     "text": "Forget the mountain. Just get to one thousand."
    },
    {
     "start": 135.385,
     "end": 137.708,
     "text": "One thousand dollars is small enough to"
    },
    {
     "start": 137.708,
     "end": 139.972,
     "text": "reach... and big enough to handle most"
    },
    {
     "start": 139.972,
     "end": 142.117,
     "text": "of the surprises life throws at you."
    },
    {
     "start": 142.297,
     "end": 144.519,
     "text": "Then you'd worry about the big mountain later."
    }
   ]
  },
  {
   "id": "s11",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 144.799,
   "end": 157.802,
   "line_starts": [
    144.799,
    149.386,
    151.989,
    155.858
   ],
   "subs": [
    {
     "start": 144.799,
     "end": 146.533,
     "text": "A flat tire. A vet bill."
    },
    {
     "start": 146.533,
     "end": 149.206,
     "text": "A dentist visit. A plane ticket home."
    },
    {
     "start": 149.386,
     "end": 151.809,
     "text": "Most of those fit under a thousand dollars."
    },
    {
     "start": 151.989,
     "end": 153.776,
     "text": "That's why it's the first goal."
    },
    {
     "start": 153.776,
     "end": 154.871,
     "text": "Not the last one..."
    },
    {
     "start": 154.871,
     "end": 155.678,
     "text": "the first one."
    },
    {
     "start": 155.858,
     "end": 157.522,
     "text": "Small goal. Big relief."
    }
   ]
  },
  {
   "id": "s12",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 157.802,
   "end": 168.603,
   "line_starts": [
    157.802,
    161.408,
    163.849,
    166.625
   ],
   "subs": [
    {
     "start": 157.802,
     "end": 160.086,
     "text": "Move number one took you twelve minutes."
    },
    {
     "start": 160.086,
     "end": 161.228,
     "text": "On your lunch break."
    },
    {
     "start": 161.408,
     "end": 163.669,
     "text": "You opened a brand-new savings account."
    },
    {
     "start": 163.849,
     "end": 165.27,
     "text": "Not at your usual bank."
    },
    {
     "start": 165.27,
     "end": 166.445,
     "text": "At a different one."
    },
    {
     "start": 166.625,
     "end": 168.323,
     "text": "One with no monthly fees."
    }
   ]
  },
  {
   "id": "s13",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 168.603,
   "end": 178.417,
   "line_starts": [
    168.603,
    171.43,
    175.927
   ],
   "subs": [
    {
     "start": 168.603,
     "end": 169.786,
     "text": "Why a different bank?"
    },
    {
     "start": 169.786,
     "end": 171.25,
     "text": "Because you know yourself."
    },
    {
     "start": 171.43,
     "end": 173.224,
     "text": "If the savings sit right next to"
    },
    {
     "start": 173.224,
     "end": 175.747,
     "text": "your checking account, one tap moves it back."
    },
    {
     "start": 175.927,
     "end": 177.381,
     "text": "Late at night. On a sale."
    },
    {
     "start": 177.381,
     "end": 178.137,
     "text": "On a bad day."
    }
   ]
  },
  {
   "id": "s14",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 178.417,
   "end": 190.505,
   "line_starts": [
    178.417,
    182.614,
    185.531,
    188.228
   ],
   "subs": [
    {
     "start": 178.417,
     "end": 180.001,
     "text": "But if it's at another bank,"
    },
    {
     "start": 180.001,
     "end": 181.359,
     "text": "it takes a day or two to"
    },
    {
     "start": 181.359,
     "end": 182.434,
     "text": "get the money back."
    },
    {
     "start": 182.614,
     "end": 183.633,
     "text": "And those two days?"
    },
    {
     "start": 183.633,
     "end": 185.351,
     "text": "They're your cooling-off period."
    },
    {
     "start": 185.531,
     "end": 188.048,
     "text": "Most impulse buys don't survive two days."
    },
    {
     "start": 188.228,
     "end": 190.225,
     "text": "Annoying? That's exactly the point."
    }
   ]
  },
  {
   "id": "s15",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 190.505,
   "end": 201.474,
   "line_starts": [
    190.505,
    195.159,
    197.479
   ],
   "subs": [
    {
     "start": 190.505,
     "end": 192.714,
     "text": "You picked a high-yield savings account,"
    },
    {
     "start": 192.714,
     "end": 194.979,
     "text": "so the money earns a little interest too."
    },
    {
     "start": 195.159,
     "end": 197.299,
     "text": "Rates change, so it's not a fortune."
    },
    {
     "start": 197.479,
     "end": 199.22,
     "text": "But it's a lot better than the"
    },
    {
     "start": 199.22,
     "end": 201.194,
     "text": "almost-zero your old account paid."
    }
   ]
  },
  {
   "id": "s16",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 201.474,
   "end": 214.946,
   "line_starts": [
    201.474,
    204.392,
    206.781,
    211.688
   ],
   "subs": [
    {
     "start": 201.474,
     "end": 204.212,
     "text": "And you gave the account a name. Not 'Savings'."
    },
    {
     "start": 204.392,
     "end": 206.601,
     "text": "You called it... 'Car Breaks Down Fund'."
    },
    {
     "start": 206.781,
     "end": 208.334,
     "text": "Sounds silly? It's not."
    },
    {
     "start": 208.334,
     "end": 210.157,
     "text": "A name with a purpose is so"
    },
    {
     "start": 210.157,
     "end": 211.508,
     "text": "much harder to raid."
    },
    {
     "start": 211.688,
     "end": 213.462,
     "text": "Every time you open the app,"
    },
    {
     "start": 213.462,
     "end": 214.666,
     "text": "it reminds you why."
    }
   ]
  },
  {
   "id": "s17",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 214.946,
   "end": 225.649,
   "line_starts": [
    214.946,
    216.998,
    221.152
   ],
   "subs": [
    {
     "start": 214.946,
     "end": 216.818,
     "text": "Move number two is the big one."
    },
    {
     "start": 216.998,
     "end": 219.148,
     "text": "You set up an automatic transfer."
    },
    {
     "start": 219.148,
     "end": 220.972,
     "text": "Fifty dollars. Every payday."
    },
    {
     "start": 221.152,
     "end": 223.074,
     "text": "You get paid every two weeks..."
    },
    {
     "start": 223.074,
     "end": 225.369,
     "text": "so that's six paydays in ninety days."
    }
   ]
  },
  {
   "id": "s18",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 225.649,
   "end": 238.562,
   "line_starts": [
    225.649,
    230.243,
    233.844,
    235.382
   ],
   "subs": [
    {
     "start": 225.649,
     "end": 228.147,
     "text": "Here's the secret. The transfer happens the"
    },
    {
     "start": 228.147,
     "end": 230.063,
     "text": "same morning your paycheck lands."
    },
    {
     "start": 230.243,
     "end": 231.954,
     "text": "Before rent. Before groceries."
    },
    {
     "start": 231.954,
     "end": 233.664,
     "text": "Before you even see the money."
    },
    {
     "start": 233.844,
     "end": 235.202,
     "text": "You pay yourself first."
    },
    {
     "start": 235.382,
     "end": 236.917,
     "text": "Whatever's left after that?"
    },
    {
     "start": 236.917,
     "end": 238.282,
     "text": "That's what you live on."
    }
   ]
  },
  {
   "id": "s19",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 238.562,
   "end": 250.444,
   "line_starts": [
    238.562,
    242.43,
    245.036,
    248.211
   ],
   "subs": [
    {
     "start": 238.562,
     "end": 240.799,
     "text": "And Jake? Jake saves whatever is left"
    },
    {
     "start": 240.799,
     "end": 242.25,
     "text": "at the end of the month."
    },
    {
     "start": 242.43,
     "end": 244.856,
     "text": "Which is... nothing. Every single month."
    },
    {
     "start": 245.036,
     "end": 247.168,
     "text": "Because there's never anything left at the"
    },
    {
     "start": 247.168,
     "end": 248.031,
     "text": "end of the month."
    },
    {
     "start": 248.211,
     "end": 250.164,
     "text": "And he wonders why it never works."
    }
   ]
  },
  {
   "id": "s20",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 250.444,
   "end": 260.583,
   "line_starts": [
    250.444,
    254.642,
    257.433
   ],
   "subs": [
    {
     "start": 250.444,
     "end": 252.575,
     "text": "The first transfer stings a little."
    },
    {
     "start": 252.575,
     "end": 254.462,
     "text": "Fifty dollars feels like a lot."
    },
    {
     "start": 254.642,
     "end": 255.834,
     "text": "But by the third one?"
    },
    {
     "start": 255.834,
     "end": 257.253,
     "text": "You don't even notice it."
    },
    {
     "start": 257.433,
     "end": 259.572,
     "text": "Your spending just quietly adjusts to the"
    },
    {
     "start": 259.572,
     "end": 260.303,
     "text": "money you see."
    }
   ]
  },
  {
   "id": "s21",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 260.583,
   "end": 272.065,
   "line_starts": [
    260.583,
    262.924,
    266.185,
    269.177
   ],
   "subs": [
    {
     "start": 260.583,
     "end": 262.744,
     "text": "Six paydays. Fifty dollars each."
    },
    {
     "start": 262.924,
     "end": 264.465,
     "text": "That's three hundred dollars."
    },
    {
     "start": 264.465,
     "end": 266.005,
     "text": "And you didn't lift a finger."
    },
    {
     "start": 266.185,
     "end": 268.997,
     "text": "That's thirty percent of your goal. On autopilot."
    },
    {
     "start": 269.177,
     "end": 271.785,
     "text": "Every two weeks, without even thinking about it."
    }
   ]
  },
  {
   "id": "s22",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 272.065,
   "end": 285.719,
   "line_starts": [
    272.065,
    276.521,
    279.04,
    282.685
   ],
   "subs": [
    {
     "start": 272.065,
     "end": 274.455,
     "text": "Move number three. One Sunday evening,"
    },
    {
     "start": 274.455,
     "end": 276.341,
     "text": "you open your bank statements."
    },
    {
     "start": 276.521,
     "end": 277.78,
     "text": "Three months of them."
    },
    {
     "start": 277.78,
     "end": 278.86,
     "text": "With a cup of tea."
    },
    {
     "start": 279.04,
     "end": 281.161,
     "text": "And you highlight every single thing that"
    },
    {
     "start": 281.161,
     "end": 282.505,
     "text": "charges you automatically."
    },
    {
     "start": 282.685,
     "end": 285.439,
     "text": "Boring? Maybe. But this is where money hides."
    }
   ]
  },
  {
   "id": "s23",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 285.719,
   "end": 296.125,
   "line_starts": [
    285.719,
    288.458,
    291.582
   ],
   "subs": [
    {
     "start": 285.719,
     "end": 288.278,
     "text": "A streaming service you haven't opened since summer."
    },
    {
     "start": 288.458,
     "end": 291.402,
     "text": "A fitness app from your January motivation phase."
    },
    {
     "start": 291.582,
     "end": 294.195,
     "text": "A cloud storage upgrade you don't even"
    },
    {
     "start": 294.195,
     "end": 295.845,
     "text": "need. Wait... seriously?"
    }
   ]
  },
  {
   "id": "s24",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 296.125,
   "end": 309.488,
   "line_starts": [
    296.125,
    298.91,
    301.128,
    304.662
   ],
   "subs": [
    {
     "start": 296.125,
     "end": 297.487,
     "text": "Thirty dollars a month."
    },
    {
     "start": 297.487,
     "end": 298.73,
     "text": "Gone. Just like that."
    },
    {
     "start": 298.91,
     "end": 300.948,
     "text": "You didn't miss a single one of them."
    },
    {
     "start": 301.128,
     "end": 303.643,
     "text": "Over three months, that's ninety dollars back"
    },
    {
     "start": 303.643,
     "end": 304.482,
     "text": "in your pocket."
    },
    {
     "start": 304.662,
     "end": 307.147,
     "text": "Thirty dollars a month doesn't sound like"
    },
    {
     "start": 307.147,
     "end": 309.208,
     "text": "much... until you see it in a jar."
    }
   ]
  },
  {
   "id": "s25",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 309.488,
   "end": 322.148,
   "line_starts": [
    309.488,
    312.673,
    316.636,
    318.471
   ],
   "subs": [
    {
     "start": 309.488,
     "end": 312.493,
     "text": "Jake has the same subscriptions. Actually more."
    },
    {
     "start": 312.673,
     "end": 314.106,
     "text": "He knows he should check."
    },
    {
     "start": 314.106,
     "end": 316.456,
     "text": "He keeps saying he'll do it next weekend."
    },
    {
     "start": 316.636,
     "end": 318.291,
     "text": "Next weekend never comes."
    },
    {
     "start": 318.471,
     "end": 320.714,
     "text": "Meanwhile, the charges keep coming."
    },
    {
     "start": 320.714,
     "end": 321.868,
     "text": "Month after month."
    }
   ]
  },
  {
   "id": "s26",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 322.148,
   "end": 330.101,
   "line_starts": [
    322.148,
    324.36,
    327.66
   ],
   "subs": [
    {
     "start": 322.148,
     "end": 324.18,
     "text": "Move number four was actually fun."
    },
    {
     "start": 324.36,
     "end": 327.48,
     "text": "You walked around your apartment and asked one question."
    },
    {
     "start": 327.66,
     "end": 329.136,
     "text": "What here have I not used in"
    },
    {
     "start": 329.136,
     "end": 329.821,
     "text": "a whole year?"
    }
   ]
  },
  {
   "id": "s27",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 330.101,
   "end": 341.617,
   "line_starts": [
    330.101,
    331.839,
    333.421,
    338.791
   ],
   "subs": [
    {
     "start": 330.101,
     "end": 331.659,
     "text": "An old phone in a drawer."
    },
    {
     "start": 331.839,
     "end": 333.241,
     "text": "A bike you rode twice."
    },
    {
     "start": 333.421,
     "end": 335.705,
     "text": "A gaming console collecting dust."
    },
    {
     "start": 335.705,
     "end": 338.611,
     "text": "And a jacket with the tags still on. Ouch."
    },
    {
     "start": 338.791,
     "end": 341.337,
     "text": "Be honest... you've got a drawer like this too."
    }
   ]
  },
  {
   "id": "s28",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 341.617,
   "end": 353.432,
   "line_starts": [
    341.617,
    345.453,
    348.082,
    350.591
   ],
   "subs": [
    {
     "start": 341.617,
     "end": 343.445,
     "text": "You took photos in good light."
    },
    {
     "start": 343.445,
     "end": 345.273,
     "text": "You wrote honest descriptions."
    },
    {
     "start": 345.453,
     "end": 347.902,
     "text": "You priced them a little below everyone else."
    },
    {
     "start": 348.082,
     "end": 350.411,
     "text": "And you listed them all on a Saturday morning."
    },
    {
     "start": 350.591,
     "end": 351.9,
     "text": "Stuff you don't need..."
    },
    {
     "start": 351.9,
     "end": 353.152,
     "text": "but someone else does."
    }
   ]
  },
  {
   "id": "s29",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 353.432,
   "end": 364.823,
   "line_starts": [
    353.432,
    357.61,
    359.626,
    362.815
   ],
   "subs": [
    {
     "start": 353.432,
     "end": 355.403,
     "text": "By Sunday night, three of them were"
    },
    {
     "start": 355.403,
     "end": 357.43,
     "text": "gone. The fourth sold that Thursday."
    },
    {
     "start": 357.61,
     "end": 359.446,
     "text": "Two hundred thirty-five dollars."
    },
    {
     "start": 359.626,
     "end": 360.916,
     "text": "Money you already had..."
    },
    {
     "start": 360.916,
     "end": 362.635,
     "text": "it was just sitting in a drawer."
    },
    {
     "start": 362.815,
     "end": 364.543,
     "text": "Not bad for one weekend, right?"
    }
   ]
  },
  {
   "id": "s30",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 364.823,
   "end": 376.534,
   "line_starts": [
    364.823,
    366.645,
    370.077,
    373.094
   ],
   "subs": [
    {
     "start": 364.823,
     "end": 366.465,
     "text": "And here's a little rule you made."
    },
    {
     "start": 366.645,
     "end": 369.125,
     "text": "Every dollar from selling stuff goes straight"
    },
    {
     "start": 369.125,
     "end": 369.897,
     "text": "into the fund."
    },
    {
     "start": 370.077,
     "end": 371.968,
     "text": "Not 'just this once' into a dinner"
    },
    {
     "start": 371.968,
     "end": 372.914,
     "text": "out. Straight in."
    },
    {
     "start": 373.094,
     "end": 376.254,
     "text": "Because money that feels like a bonus disappears fast."
    }
   ]
  },
  {
   "id": "s31",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 376.534,
   "end": 386.438,
   "line_starts": [
    376.534,
    379.671,
    380.703,
    385.232
   ],
   "subs": [
    {
     "start": 376.534,
     "end": 378.526,
     "text": "Move number five is where most of"
    },
    {
     "start": 378.526,
     "end": 379.491,
     "text": "the money hides."
    },
    {
     "start": 379.671,
     "end": 380.523,
     "text": "Groceries."
    },
    {
     "start": 380.703,
     "end": 382.696,
     "text": "Not because you buy fancy food..."
    },
    {
     "start": 382.696,
     "end": 385.052,
     "text": "but because you shopped without a plan."
    },
    {
     "start": 385.232,
     "end": 386.158,
     "text": "Let me show you."
    }
   ]
  },
  {
   "id": "s32",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 386.438,
   "end": 396.898,
   "line_starts": [
    386.438,
    389.587,
    391.3
   ],
   "subs": [
    {
     "start": 386.438,
     "end": 389.407,
     "text": "Before, you'd walk into the store hungry after work."
    },
    {
     "start": 389.587,
     "end": 391.12,
     "text": "No list. Just vibes."
    },
    {
     "start": 391.3,
     "end": 392.693,
     "text": "Snacks, a fancy sauce,"
    },
    {
     "start": 392.693,
     "end": 394.212,
     "text": "a second bag of chips..."
    },
    {
     "start": 394.212,
     "end": 396.618,
     "text": "and half of it went bad in the fridge."
    }
   ]
  },
  {
   "id": "s33",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 396.898,
   "end": 405.152,
   "line_starts": [
    396.898,
    398.942,
    400.936
   ],
   "subs": [
    {
     "start": 396.898,
     "end": 398.762,
     "text": "Now? Every Sunday, ten minutes."
    },
    {
     "start": 398.942,
     "end": 400.756,
     "text": "You check what's already in the fridge."
    },
    {
     "start": 400.936,
     "end": 402.268,
     "text": "You plan five dinners."
    },
    {
     "start": 402.268,
     "end": 403.297,
     "text": "You write a list."
    },
    {
     "start": 403.297,
     "end": 404.872,
     "text": "And you never shop hungry."
    }
   ]
  },
  {
   "id": "s34",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 405.152,
   "end": 418.55,
   "line_starts": [
    405.152,
    408.692,
    413.104,
    416.285
   ],
   "subs": [
    {
     "start": 405.152,
     "end": 406.519,
     "text": "You cook a little extra,"
    },
    {
     "start": 406.519,
     "end": 408.512,
     "text": "so dinner becomes tomorrow's lunch."
    },
    {
     "start": 408.692,
     "end": 411.161,
     "text": "You buy the store brand for basics."
    },
    {
     "start": 411.161,
     "end": 412.924,
     "text": "Rice, pasta, oats, beans."
    },
    {
     "start": 413.104,
     "end": 416.105,
     "text": "Same food. Just... without the expensive label."
    },
    {
     "start": 416.285,
     "end": 418.27,
     "text": "And nothing goes in the trash anymore."
    }
   ]
  },
  {
   "id": "s35",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 418.55,
   "end": 428.777,
   "line_starts": [
    418.55,
    423.109,
    426.038
   ],
   "subs": [
    {
     "start": 418.55,
     "end": 420.894,
     "text": "The result? Your grocery bill drops by"
    },
    {
     "start": 420.894,
     "end": 422.929,
     "text": "about twenty-five dollars a week."
    },
    {
     "start": 423.109,
     "end": 424.484,
     "text": "You're not eating worse."
    },
    {
     "start": 424.484,
     "end": 425.858,
     "text": "You're just not wasting."
    },
    {
     "start": 426.038,
     "end": 428.497,
     "text": "Twelve weeks... that's three hundred dollars."
    }
   ]
  },
  {
   "id": "s36",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 428.777,
   "end": 443.21,
   "line_starts": [
    428.777,
    432.048,
    435.946,
    439.327
   ],
   "subs": [
    {
     "start": 428.777,
     "end": 431.868,
     "text": "Meanwhile, Jake orders delivery four nights a week."
    },
    {
     "start": 432.048,
     "end": 434.29,
     "text": "Every order comes with a delivery fee,"
    },
    {
     "start": 434.29,
     "end": 435.766,
     "text": "a service fee, and a tip."
    },
    {
     "start": 435.946,
     "end": 439.147,
     "text": "He's always surprised the burger cost twenty-eight dollars."
    },
    {
     "start": 439.327,
     "end": 441.874,
     "text": "That's over four hundred dollars a month."
    },
    {
     "start": 441.874,
     "end": 442.93,
     "text": "Just on delivery."
    }
   ]
  },
  {
   "id": "s37",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 443.21,
   "end": 456.612,
   "line_starts": [
    443.21,
    445.926,
    449.865,
    453.473
   ],
   "subs": [
    {
     "start": 443.21,
     "end": 445.746,
     "text": "Move number six. The no-spend weekend."
    },
    {
     "start": 445.926,
     "end": 447.806,
     "text": "Once a month, from Friday night to"
    },
    {
     "start": 447.806,
     "end": 449.685,
     "text": "Sunday night... you spend nothing."
    },
    {
     "start": 449.865,
     "end": 451.417,
     "text": "No shopping. No takeout."
    },
    {
     "start": 451.417,
     "end": 453.293,
     "text": "No 'quick little' coffee run."
    },
    {
     "start": 453.473,
     "end": 454.479,
     "text": "It's a little game."
    },
    {
     "start": 454.479,
     "end": 456.332,
     "text": "And you're surprisingly good at it."
    }
   ]
  },
  {
   "id": "s38",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 456.612,
   "end": 466.697,
   "line_starts": [
    456.612,
    458.366,
    463.015
   ],
   "subs": [
    {
     "start": 456.612,
     "end": 458.186,
     "text": "Sounds boring? It wasn't."
    },
    {
     "start": 458.366,
     "end": 460.513,
     "text": "You went hiking. You had friends over"
    },
    {
     "start": 460.513,
     "end": 462.835,
     "text": "for a movie night with homemade popcorn."
    },
    {
     "start": 463.015,
     "end": 464.974,
     "text": "You finally read that book that's been"
    },
    {
     "start": 464.974,
     "end": 466.417,
     "text": "on your shelf for two years."
    }
   ]
  },
  {
   "id": "s39",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 466.697,
   "end": 478.005,
   "line_starts": [
    466.697,
    470.983,
    474.423
   ],
   "subs": [
    {
     "start": 466.697,
     "end": 468.782,
     "text": "A normal weekend used to cost you"
    },
    {
     "start": 468.782,
     "end": 470.803,
     "text": "around twenty-five dollars more."
    },
    {
     "start": 470.983,
     "end": 474.243,
     "text": "Three no-spend weekends? Seventy-five dollars."
    },
    {
     "start": 474.423,
     "end": 476.643,
     "text": "And honestly... some of the best weekends"
    },
    {
     "start": 476.643,
     "end": 477.725,
     "text": "you've had all year."
    }
   ]
  },
  {
   "id": "s40",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 478.005,
   "end": 485.468,
   "line_starts": [
    478.005,
    479.117,
    480.551,
    483.336
   ],
   "subs": [
    {
     "start": 478.005,
     "end": 478.937,
     "text": "Okay. Ready?"
    },
    {
     "start": 479.117,
     "end": 480.371,
     "text": "Let's add it all up."
    },
    {
     "start": 480.551,
     "end": 483.156,
     "text": "Fifty dollars every payday. Three hundred."
    },
    {
     "start": 483.336,
     "end": 485.188,
     "text": "Groceries. Another three hundred."
    }
   ]
  },
  {
   "id": "s41",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 485.468,
   "end": 494.265,
   "line_starts": [
    485.468,
    488.1,
    490.53,
    493.093
   ],
   "subs": [
    {
     "start": 485.468,
     "end": 487.92,
     "text": "Stuff you sold. Two hundred thirty-five."
    },
    {
     "start": 488.1,
     "end": 490.35,
     "text": "Subscriptions you cancelled. Ninety."
    },
    {
     "start": 490.53,
     "end": 492.913,
     "text": "No-spend weekends. Seventy-five."
    },
    {
     "start": 493.093,
     "end": 493.985,
     "text": "Wait for it..."
    }
   ]
  },
  {
   "id": "s42",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 494.265,
   "end": 503.417,
   "line_starts": [
    494.265,
    495.059,
    497.123,
    500.591
   ],
   "subs": [
    {
     "start": 494.265,
     "end": 494.879,
     "text": "Total?"
    },
    {
     "start": 495.059,
     "end": 496.943,
     "text": "Exactly one thousand dollars."
    },
    {
     "start": 497.123,
     "end": 499.444,
     "text": "In ninety days. On the same paycheck"
    },
    {
     "start": 499.444,
     "end": 500.411,
     "text": "you always had."
    },
    {
     "start": 500.591,
     "end": 503.137,
     "text": "Same job. Same city. Same paycheck."
    }
   ]
  },
  {
   "id": "s43",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 503.417,
   "end": 511.098,
   "line_starts": [
    503.417,
    504.836,
    506.737
   ],
   "subs": [
    {
     "start": 503.417,
     "end": 504.656,
     "text": "You didn't get a raise."
    },
    {
     "start": 504.836,
     "end": 506.557,
     "text": "You didn't stop seeing your friends."
    },
    {
     "start": 506.737,
     "end": 508.777,
     "text": "You didn't eat rice and beans every"
    },
    {
     "start": 508.777,
     "end": 510.818,
     "text": "day. You just... stopped the leaks."
    }
   ]
  },
  {
   "id": "s44",
   "visual": "sketch",
   "params": {},
   "heading": "",
   "start": 511.098,
   "end": 521.258,
   "line_starts": [
    511.098,
    514.096,
    515.611,
    518.113
   ],
   "subs": [
    {
     "start": 511.098,
     "end": 512.742,
     "text": "And then, two weeks later..."
    },
    {
     "start": 512.742,
     "end": 513.916,
     "text": "that grinding sound."
    },
    {
     "start": 514.096,
     "end": 515.431,
     "text": "Six hundred dollars."
    },
    {
     "start": 515.611,
     "end": 517.069,
     "text": "You pay it. You drive home."
    },
    {
     "start": 517.069,
