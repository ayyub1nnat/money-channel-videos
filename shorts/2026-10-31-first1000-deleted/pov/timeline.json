{
 "title": "POV: You Save Your First $1,000 in 90 Days \u2014 Jake Earns $900 More and Has $0 When His Car Breaks",
 "duration": 589.775,
 "scenes": [
  {
   "id": "s0",
   "visual": "sketch",
   "params": {},
