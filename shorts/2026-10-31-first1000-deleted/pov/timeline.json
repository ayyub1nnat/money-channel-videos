   "subs": [
    {
     "start": 521.258,
     "end": 523.067,
     "text": "And here's the most important part."
    },
    {
     "start": 523.247,
     "end": 525.703,
     "text": "You don't stop. Your fifty dollars keeps"
    },
    {
     "start": 525.703,
     "end": 527.115,
     "text": "going in, every payday."
    },
    {
     "start": 527.295,
     "end": 529.18,
     "text": "Because now the goal is to refill"
